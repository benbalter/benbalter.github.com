{
  "plugins": {
    "@textlint/markdown": {
      "extensions": [
        ".mdx"
      ]
    }
  },
  "filters": {},
  "rules": {
    "no-start-duplicated-conjunction": true,
    "terminology": {
      "exclude": [
        "HTML",
        "ID",
        "URL",
        "e2e",
        "JavaScript",
        "GitHub",
        "V[ -]?S[ -]?Code",
        "web[- ]?site(s)?",
        "repo\\b",
        "readme(s)?",
        "style-?sheet(s)?",
        "copy[- ]past(e|ed|ing)?",
        "over[- ]engineer(ing|ed)",
        "end-?user(s)?",
        "built ?in(s)?",
        "GIF"
      ]
    },
    "write-good": {
      "severity": "warning",
      "passive": false,
      "adverb": false,
      "weasel": false,
      "so": false,
      "thereIs": false
    },
    "diacritics": true,
    "doubled-spaces": true,
    "stop-words": {
      "severity": "warning",
      "exclude": [
        "so as to",
        "e.g.",
        "etc.",
        "i.e.",
        "if you want to",
        "in addition to"
      ]
    },
    "@textlint-rule/no-unmatched-pair": true,
    "@textlint-rule/no-duplicate-abbr": true,
    "common-misspellings": {
      "ignore": [
        "CLAs"
      ]
    }
  }
}
