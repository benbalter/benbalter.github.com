#!/bin/bash
# PostToolUse check for Edit/Write: runs ESLint on just the edited JS/TS/JSON
# file, check-only. AGENTS.md says to lint only the files you touched; this does
# it automatically and feeds errors back while the file is still open.
#
# No --fix: rewriting the file right after Claude's Edit would make its next
# Edit fail on a stale read. eslint.config.js decides what's in scope;
# --no-warn-ignored keeps files it ignores (dist-astro/, .astro/) quiet.
#
# Input: the hook JSON on stdin. Output: a "block" decision whose reason is fed
# back to Claude (the edit itself stays), or nothing.

file=$(jq -r '.tool_input.file_path // ""')
[ -f "$file" ] || exit 0
case "$file" in *.ts | *.js | *.mjs | *.cjs | *.json) ;; *) exit 0 ;; esac
root=$(git -C "$(dirname "$file")" rev-parse --show-toplevel 2>/dev/null) || exit 0
cd "$root" || exit 0
[ -x node_modules/.bin/eslint ] || exit 0

out=$(node_modules/.bin/eslint --no-warn-ignored --quiet "$file" 2>&1) && exit 0

jq -n --arg out "${out:0:4000}" '{
  decision: "block",
  reason: ("ESLint errors in the file you just edited (fix them; do not run eslint --fix repo-wide):\n" + $out)
}'
