  "homepage": "https://github.com/benbalter/benbalter.github.com#readme",
  "license": "CC-BY-3.0",
  "name": "benbalter.github.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/benbalter/benbalter.github.com.git"
  },
  "scripts": {
    "build": "astro build && script/inject-modulepreload && script/inject-image-size && pagefind --site dist-astro",
    "dev": "astro dev",
    "preview": "astro preview",
    "check": "astro check --tsconfig tsconfig.astro.json",
    "check:tooling": "tsc -p tsconfig.tooling.json",
    "validate-seo": "tsx script/validate-seo.ts",
    "check-content-integrity": "tsx script/check-content-integrity.ts",
    "vale-ai-tells": "vale --config=.vale-ai-tells.ini",
    "analytics": "node script/analytics.mjs",
    "standard-site:publication": "tsx script/standard-site/create-publication.ts",
    "standard-site:sync": "tsx script/standard-site/sync-document.ts",
    "lint": "npm run lint-js && npm run lint-json && npm run lint-md",
    "lint-check": "npm run lint-js-check && npm run lint-json-check && remark . && npm run lint-md-check",
    "lint-js": "eslint . --fix",
    "lint-js-check": "eslint .",
    "lint-json": "eslint --fix '**/*.json'",
    "lint-json-check": "eslint '**/*.json'",
    "knip": "knip",
    "lint-md": "remark . && markdownlint-cli2 --fix \"**/*.{md,mdx}\" \"!node_modules\" \"!.github\"",
    "lint-md-check": "markdownlint-cli2 \"**/*.{md,mdx}\" \"!node_modules\" \"!.github\"",
    "lint-text": "textlint *.md src/content/posts/*.md src/content/posts/*.mdx src/content/resume-positions/*.md --fix --dry-run",
    "lint-yaml": "yamllint -c .yamllint.yml .github/workflows/ src/data/*.yml .yamllint.yml .markdown-lint.yml",
    "lint-html": "html-validate \"dist-astro/**/*.html\"",
    "super-linter": "script/super-linter",
    "test": "npm run check && npm run check:tooling && npm run lint-check && npm run test:vitest",
    "test:e2e": "playwright test",
    "test:e2e:accessibility": "playwright test e2e/accessibility-astro.spec.ts",
    "test:e2e:performance": "playwright test e2e/performance-astro.spec.ts",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "test:vitest": "vitest run",
    "test:vitest:watch": "vitest",
    "test:vitest:ui": "vitest --ui",
    "test:vitest:coverage": "vitest run --coverage"
  },
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "version": "1.0.0",
  "overrides": {
    "typescript": "$typescript",
    "yaml-language-server": {
      "yaml": "^2.8.3"
    },
    "deepmerge-ts": "^8.0.0",
    "sharp": "^0.35.0"
  }
}
