.DS_Store
node_modules
/tmp
.github/styles/*
# Keep the directory itself: Vale refuses to run (even `vale sync`) when
# StylesPath doesn't exist, and every style is now a synced package.
!.github/styles/.gitkeep
# Astro build artifacts
dist-astro/
.astro/

# Build caches (OG images, etc.) — restored/saved by CI, never committed
.cache/

# Cloudflare Wrangler local state
.wrangler/

# Lighthouse CI artifacts
.lighthouseci/

# lychee link-check cache and report (links.yml)
.lycheecache
lychee-report.md

# Playwright artifacts
test-results/
playwright-report/
playwright/.cache/

# Vitest coverage
coverage/

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
screenshots/

# Local analytics report (contains specific stats; do not commit)
analytics-report.md

# Popular posts with traffic counts, generated at deploy by
# script/popular-posts.ts. The repo is public, so never commit it.
src/data/popular-posts.json

# AI-generated post drafts (script/foundry-drafts.ts) — scratch, edit before publishing
drafts/

# AI-generated QA report (script/foundry-qa.ts) — review notes, not published
qa/

# AI-generated interlinking audit (script/foundry-interlinks.ts) — review notes
audit/

# AI-generated engagement audit (script/foundry-engagement.ts) — review notes
engage/

# Throwaway local probes and experiments
*-tmp.*

# Claude Code agent worktrees
.claude/worktrees/
