{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "script/**/*.{ts,mjs,js}",
    // Extensionless Node scripts run from package.json and CI.
    "script/{inject-image-size,inject-modulepreload,build-remote-image-dimensions}",
    // Auto-imported into MDX posts by astro-auto-import (astro.config.mjs).
    "src/components/{GitHubCulture,FossAtScale,YouTube,BookLaunchCta}.astro"
  ],
  "project": [
    "src/**/*.{ts,astro,css,mdx}",
    "script/**/*.{ts,mjs,js}",
    "worker/**/*.js",
    "e2e/**/*.ts"
  ],
  "ignoreDependencies": [
    // Bundled with textlint; named in .textlintrc.
    "@textlint/textlint-plugin-markdown",
    // Referenced by string in .remarkrc.js's remark-textr plugin list.
    "typographic-copyright",
    // Required by the extensionless script/inject-image-size and
    // script/inject-modulepreload, which knip can't parse.
    "image-size",
    "es-module-lexer"
  ],
  // System tools, not npm packages: vale and yamllint are installed in CI;
  // op is the 1Password CLI that script/analytics.mjs shells out to locally
  // to resolve op:// references in .env.
  "ignoreBinaries": ["vale", "yamllint", "op"],
  // Unused files, dependencies, imports, exports, and exported types all fail.
  // Constants exported only "for documentation" read as public API; keep them
  // module-private unless something imports them.
  "rules": {
    "exports": "error",
    "types": "error"
  }
}
