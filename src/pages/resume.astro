---
/**
 * Resume Page
 *
 * The web résumé, built for a 30-second scan: name, headline, contact, and
 * downloads first; then the summary and highlights; then a compact role ladder
 * whose older roles expand on demand (native <details>, no JS). Every role's
 * full text stays in the HTML, so find-in-page, search engines, and the
 * Markdown/Word/PDF exports (built from the same sources) see all of it.
 */

import PageLayout from '../layouts/PageLayout.astro';
import Icon from '../components/Icon.astro';
import { Image } from 'astro:assets';
import { getEntry, type CollectionEntry } from 'astro:content';
import { siteConfig } from '../config';
import { getPublishedPosts } from '../utils/posts';
import { resolveResumeWriting } from '../utils/resume-writing';
import { RESUME_HEADLINE, getResumePositions, typographicApostrophes } from '../utils/resume-data';
import { generateResumeSchema, schemaToJsonLd } from '../utils/structured-data';
import bookCover from '../../assets/img/open-and-async-cover-left.webp';

// The Open and Async position shows the book's cover inline (see loop below).
const BOOK_POSITION_ID = 'owner';

// How many of the most recent roles render expanded. The rest collapse to a
// one-line title and date row so the whole career fits on a screen or two.
const OPEN_ROLE_COUNT = 2;

// Load resume page data
const resumePage = await getEntry('pages', 'resume');
if (!resumePage) {
  throw new Error('Resume page data not found');
}

const { title, description, robots, degrees, certifications, skills, summary, highlights } = resumePage.data;

// Selected writing comes from the curated resumeWritingSlugs list.
const writing = resolveResumeWriting(await getPublishedPosts());

// Load positions (sorted + grouped by employer, pre-rendered) from the shared
// util so the web resume and the /resume/print PDF source can't drift.
const { sorted: sortedPositions, grouped: groupedPositions } = await getResumePositions();
const openRoleIds = new Set(sortedPositions.slice(0, OPEN_ROLE_COUNT).map((p) => p.id));

// "Feb 2016": short enough to sit on the same line as a role title on a phone.
const shortDate = (value: string | undefined) => {
  if (!value) return 'Present';
  const date = new Date(value);
  return isNaN(date.getTime())
    ? 'Unknown'
    : date.toLocaleDateString('en-US', { month: 'short', year: 'numeric', timeZone: 'UTC' });
};
const year = (value: string) => new Date(value).getUTCFullYear();

// Tenure per employer ("2013–2026"), so the GitHub progression reads at a glance.
const tenure = (positions: CollectionEntry<'resume-positions'>[]) => {
  const start = Math.min(...positions.map((p) => year(p.data.start_date)));
  const ends = positions.map((p) => p.data.end_date);
  const end = ends.some((e) => !e) ? 'Present' : String(Math.max(...ends.map((e) => year(e!))));
  return String(start) === end ? end : `${start}–${end}`;
};

type Cert = { authority: string; name: string; url?: string; expired?: boolean; category?: string };
const professionalCerts = (certifications ?? []).filter((c: Cert) => (c.category ?? 'professional') === 'professional');
const personalCerts = (certifications ?? []).filter((c: Cert) => c.category === 'personal');

const downloads = [
  { href: '/resume.pdf', file: 'ben-balter-resume.pdf', label: 'PDF', primary: true },
  { href: '/resume.docx', file: 'ben-balter-resume.docx', label: 'Word', primary: false },
  { href: '/resume.md', file: 'ben-balter-resume.md', label: 'Markdown', primary: false },
];

// Generate resume structured data (JSON-LD)
const resumeSchema = generateResumeSchema({
  positions: sortedPositions.map((p: CollectionEntry<'resume-positions'>) => ({
    employer: p.data.employer,
    title: p.data.title,
    startDate: p.data.start_date,
    endDate: p.data.end_date,
  })),
  degrees,
  certifications,
});
---

<PageLayout title={title} description={description} robots={robots} suppressPersonSchema>
  <header slot="header" class="resume-masthead">
    <h1 class="resume-name">{siteConfig.author}<span class="sr-only">: {title}</span></h1>
    <p class="resume-headline">{RESUME_HEADLINE}</p>
    <p class="resume-contact">
      <span>Washington, DC</span>
      <a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a>
      <a href="https://www.linkedin.com/in/benbalter/" rel="me">LinkedIn</a>
      <a href="https://github.com/benbalter" rel="me">GitHub</a>
      <a class="print-only" href="https://ben.balter.com">ben.balter.com</a>
    </p>
    <ul class="resume-downloads" aria-label="Download the résumé">
      {downloads.map((d) => (
        <li>
          <a href={d.href} download={d.file} class:list={['btn', 'resume-download', { 'resume-download-primary': d.primary }]}>
            <Icon name="download" size="1.1em" />
            <span><span class="sr-only">Download as </span>{d.label}</span>
          </a>
        </li>
      ))}
    </ul>
  </header>

  <div class="resume">
    {summary && <p class="resume-summary">{typographicApostrophes(summary)}</p>}

    {highlights && highlights.length > 0 && (
      <section class="resume-section" aria-labelledby="highlights">
        <h2 id="highlights">Highlights</h2>
        <ul class="highlight-list">
          {highlights.map((item: string) => (
            <li>{typographicApostrophes(item)}</li>
          ))}
        </ul>
      </section>
    )}

    <section class="resume-section" aria-labelledby="experience">
      <h2 id="experience">Experience</h2>

      {groupedPositions.map((group) => (
        <div class="employer-group">
          <h3 class="employer-name">
            {group.employer}
            <span class="employer-tenure">{tenure(group.positions)}</span>
          </h3>

          <ul class="role-ladder">
            {group.positions.map((position) => (
              <li>
                <details class="role" open={openRoleIds.has(position.id)}>
                  <summary class="role-summary">
                    <span class="role-title">{position.data.title}</span>
                    <span class="role-dates">
                      {shortDate(position.data.start_date)}–{shortDate(position.data.end_date)}
                    </span>
                    <Icon name="chevron-down" class="role-chevron" size="1.1em" />
                  </summary>
                  <div class:list={['role-body', { 'role-body-with-cover': position.id === BOOK_POSITION_ID }]}>
                    {position.id === BOOK_POSITION_ID && (
                      <Image
                        src={bookCover}
                        alt="Open and Async book cover"
                        width={120}
                        height={147}
                        densities={[1, 2]}
                        loading="lazy"
                        decoding="async"
                        class="role-cover"
                      />
                    )}
                    <position.Content />
                  </div>
                </details>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </section>

    {writing && writing.length > 0 && (
      <section class="resume-section" aria-labelledby="writing">
        <h2 id="writing">Selected writing</h2>
        <ul class="writing-list" data-link-previews>
          {writing.map((item) => (
            <li><a href={item.path}>{item.title}</a></li>
          ))}
        </ul>
      </section>
    )}

    {skills && skills.length > 0 && (
      <section class="resume-section" aria-labelledby="focus">
        <h2 id="focus">Areas of focus</h2>
        <dl class="skills">
          {skills.map((group: { group: string; items: string[] }) => (
            <div class="skill-row">
              <dt>{group.group}</dt>
              <dd>{group.items.join(', ')}</dd>
            </div>
          ))}
        </dl>
      </section>
    )}

    {degrees && degrees.length > 0 && (
      <section class="resume-section" aria-labelledby="education">
        <h2 id="education">Education</h2>
        <ul class="entry-list">
          {degrees.map((degree: { school: string; degree: string; date: string }) => (
            <li class="entry">
              <span class="entry-main">
                <span class="entry-title">{degree.degree}</span>
                <span class="entry-detail">{degree.school}</span>
              </span>
              <span class="entry-date">{year(degree.date)}</span>
            </li>
          ))}
        </ul>
      </section>
    )}

    {professionalCerts.length > 0 && (
      <section class="resume-section" aria-labelledby="certifications">
        <h2 id="certifications">Certifications</h2>
        <ul class="entry-list">
          {professionalCerts.map((cert: Cert) => (
            <li class="entry">
              <span class="entry-main">
                <span class="entry-title">
                  {cert.url ? (
                    <a href={cert.url} aria-label={`View ${cert.name} credential`}>{cert.name}</a>
                  ) : (
                    cert.name
                  )}
                  {cert.expired && (
                    <span class="cert-expired" title="No longer actively maintained">Expired<span class="sr-only">, no longer actively maintained</span></span>
                  )}
                </span>
                <span class="entry-detail">{cert.authority}</span>
              </span>
            </li>
          ))}
        </ul>
      </section>
    )}

    {personalCerts.length > 0 && (
      <section class="resume-section" aria-labelledby="outside-work">
        <h2 id="outside-work">Outside work</h2>
        <ul class="outside-list">
          {personalCerts.map((cert: Cert) => (
            <li>{cert.name} <span class="entry-detail">({cert.authority})</span></li>
          ))}
        </ul>
      </section>
    )}

    <section class="resume-closing" aria-labelledby="get-a-copy">
      <h2 id="get-a-copy">Get a copy</h2>
      <p>
        The same résumé as a file to forward, or reach me at
        <a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a>.
      </p>
      <ul class="resume-downloads" aria-label="Download the résumé">
        {downloads.map((d) => (
          <li>
            <a href={d.href} download={d.file} class:list={['btn', 'resume-download', { 'resume-download-primary': d.primary }]}>
              <Icon name="download" size="1.1em" />
              <span><span class="sr-only">Download as </span>{d.label}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  </div>

  <script type="application/ld+json" set:html={schemaToJsonLd(resumeSchema)} is:inline></script>

  <!-- Hover preview cards for internal post links (Selected writing) -->
  <script>
    import '../scripts/link-previews';

    // Printing the page should print every role, not just the expanded ones.
    // (The forwardable PDF is built separately from /resume/print/.)
    window.addEventListener('beforeprint', () => {
      document.querySelectorAll<HTMLDetailsElement>('.role:not([open])').forEach((role) => {
        role.open = true;
        role.dataset.printOpened = '';
      });
    });
    window.addEventListener('afterprint', () => {
      document.querySelectorAll<HTMLDetailsElement>('.role[data-print-opened]').forEach((role) => {
        role.open = false;
        delete role.dataset.printOpened;
      });
    });
  </script>
</PageLayout>

<style>
  /* ============================================================
   * Masthead: who, what kind of hire, how to reach, what to take
   * ============================================================ */
  .resume-masthead {
    max-width: 44rem;
    margin: 1.5rem 0 2.5rem;
  }

  .resume-name {
    margin: 0;
    font-size: var(--text-display, clamp(1.875rem, 1.5rem + 1.875vw, 2.441rem));
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.025em;
    color: var(--color-gray-900);
  }

  .resume-headline {
    margin: 0.5rem 0 0;
    font-size: clamp(1.0625rem, 1rem + 0.4vw, 1.25rem);
    font-weight: 500;
    line-height: 1.4;
    color: var(--color-gray-700);
    text-wrap: balance;
  }

  .resume-contact {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    column-gap: 1.25rem;
    margin: 0.5rem 0 0;
    font-size: 0.9375rem;
    color: var(--color-gray-700);
  }

  .resume-contact a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--color-primary-700);
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--color-primary) 40%, transparent);
    text-underline-offset: 0.2em;
  }

  .resume-contact a:hover {
    text-decoration-color: currentColor;
  }

  .print-only {
    display: none !important;
  }

  .resume-downloads {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0.75rem 0 0;
    padding: 0;
    list-style: none;
  }

  .resume-downloads li {
    margin: 0;
    padding: 0;
  }

  .resume-download {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 44px;
    padding: 0 0.85rem;
    border: 1px solid var(--color-gray-300);
    border-radius: 0.5rem;
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1;
    color: var(--color-gray-800);
    background-color: var(--color-white, #fff);
    text-decoration: none;
    transition: border-color 150ms ease-out, background-color 150ms ease-out, color 150ms ease-out;
  }

  .resume-download:hover {
    border-color: var(--color-primary);
    color: var(--color-primary-700);
  }

  .resume-download-primary {
    border-color: var(--color-primary);
    background-color: var(--color-primary);
    color: #fff;
  }

  .resume-download-primary:hover {
    border-color: var(--color-primary-600);
    background-color: var(--color-primary-600);
    color: #fff;
  }

  .resume-download:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  /* ============================================================
   * Body column: Inter at a ~70-character measure
   * ============================================================ */
  .resume {
    max-width: 42rem;
    font-family: var(--font-sans);
    hyphens: manual;
  }

  .resume :global(p),
  .resume :global(li) {
    hyphens: manual;
  }

  .resume-summary {
    margin: 0 0 0.5rem;
    font-size: 1.0625rem;
    line-height: 1.65;
    color: var(--color-gray-800);
  }

  .resume-section {
    margin-top: 2.75rem;
  }

  .resume-section h2,
  .resume-closing h2 {
    margin: 0 0 0.85rem;
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: -0.015em;
    color: var(--color-gray-900);
  }

  .highlight-list {
    margin: 0;
    padding-left: 1.15rem;
  }

  .highlight-list li {
    margin: 0 0 0.6rem;
    padding-left: 0.15rem;
    line-height: 1.55;
  }

  .highlight-list li:last-child {
    margin-bottom: 0;
  }

  /* ============================================================
   * Experience: employer, then a ladder of roles
   * ============================================================ */
  .employer-group + .employer-group {
    margin-top: 1.75rem;
  }

  .employer-name {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0 1rem;
    margin: 0;
    padding-bottom: 0.35rem;
    border-bottom: 1px solid var(--color-gray-300);
    font-size: 1.1875rem;
    font-weight: 700;
    line-height: 1.35;
    color: var(--color-gray-900);
  }

  .employer-tenure {
    font-size: 0.875rem;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    color: var(--color-gray-600);
  }

  .role-ladder {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .role-ladder > li {
    margin: 0;
    padding: 0;
    border-bottom: 1px solid var(--color-gray-200);
  }

  .role-ladder > li::marker {
    content: none;
  }

  .role-summary {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 44px;
    padding: 0.5rem 0;
    cursor: pointer;
    list-style: none;
  }

  .role-summary::-webkit-details-marker {
    display: none;
  }

  .role-title {
    flex: 1;
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.35;
    color: var(--color-gray-900);
    transition: color 150ms ease-out;
  }

  .role-dates {
    flex-shrink: 0;
    font-size: 0.875rem;
    font-variant-numeric: tabular-nums;
    color: var(--color-gray-600);
    white-space: nowrap;
  }

  .role-summary :global(.role-chevron) {
    flex-shrink: 0;
    color: var(--color-gray-600);
    transition: transform 200ms cubic-bezier(0.16, 1, 0.3, 1), color 150ms ease-out;
  }

  .role[open] > .role-summary :global(.role-chevron) {
    transform: rotate(180deg);
  }

  .role-summary:hover .role-title,
  .role-summary:hover :global(.role-chevron) {
    color: var(--color-primary-700);
  }

  .role-summary:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
    border-radius: 0.25rem;
  }

  .role-body {
    padding: 0 0 1rem;
    line-height: 1.6;
  }

  .role-body :global(p) {
    margin: 0 0 0.5rem;
  }

  .role-body :global(ul) {
    margin: 0.25rem 0 0;
    padding-left: 1.15rem;
  }

  .role-body :global(li) {
    margin: 0 0 0.45rem;
  }

  .role-body :global(li:last-child) {
    margin-bottom: 0;
  }

  /* Book cover floated inline within the Open and Async role (web only). */
  .role-body :global(.role-cover) {
    float: right;
    width: 96px;
    height: auto;
    margin: 0.25rem 0 0.75rem 1.25rem;
    filter: drop-shadow(0 6px 12px rgb(0 0 0 / 0.18));
  }

  .role-body-with-cover::after {
    content: '';
    display: block;
    clear: both;
  }

  /* ============================================================
   * Writing, focus, education, certifications
   * ============================================================ */
  .writing-list {
    margin: 0;
    padding-left: 1.15rem;
  }

  .writing-list li {
    margin: 0 0 0.45rem;
    line-height: 1.5;
  }

  .skills {
    margin: 0;
  }

  .skill-row {
    display: grid;
    grid-template-columns: 9.5rem 1fr;
    gap: 0.25rem 1rem;
    padding: 0.5rem 0;
    border-top: 1px solid var(--color-gray-200);
  }

  .skill-row:first-child {
    border-top: none;
    padding-top: 0;
  }

  .skill-row dt {
    font-weight: 600;
    color: var(--color-gray-900);
  }

  .skill-row dd {
    margin: 0;
    padding: 0;
    line-height: 1.55;
    color: var(--color-gray-800);
  }

  .entry-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .entry {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    margin: 0;
    padding: 0.55rem 0;
    border-top: 1px solid var(--color-gray-200);
  }

  .entry:first-child {
    border-top: none;
    padding-top: 0;
  }

  .entry::marker {
    content: none;
  }

  .entry-main {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }

  .entry-title {
    font-weight: 600;
    line-height: 1.4;
    color: var(--color-gray-900);
  }

  .entry-detail {
    font-size: 0.9375rem;
    color: var(--color-gray-600);
  }

  .entry-date {
    flex-shrink: 0;
    font-size: 0.875rem;
    font-variant-numeric: tabular-nums;
    color: var(--color-gray-600);
  }

  .cert-expired {
    display: inline-block;
    margin-left: 0.5rem;
    padding: 0.05rem 0.45rem;
    border: 1px solid var(--color-gray-300);
    border-radius: 0.25rem;
    font-size: 0.75rem;
    font-weight: 600;
    line-height: 1.4;
    color: var(--color-gray-700);
    vertical-align: 0.1em;
    white-space: nowrap;
  }

  .outside-list {
    margin: 0;
    padding-left: 1.15rem;
  }

  .outside-list li {
    margin: 0 0 0.35rem;
  }

  /* ============================================================
   * Closing: the page ends on what to do next
   * ============================================================ */
  .resume-closing {
    margin-top: 3rem;
    padding: 1.5rem;
    border: 1px solid var(--color-gray-200);
    border-radius: 0.5rem;
    background-color: var(--color-gray-100);
  }

  .resume-closing p {
    margin: 0;
    line-height: 1.55;
    color: var(--color-gray-800);
  }

  /* Plain primary is 4.32:1 on the gray-100 panel; step down for AA. */
  .resume-closing p a {
    color: var(--color-primary-700);
  }

  /* ============================================================
   * Dark mode
   * ============================================================ */
  @media (prefers-color-scheme: dark) {
    .resume-name,
    .resume-section h2,
    .resume-closing h2,
    .employer-name,
    .role-title,
    .skill-row dt,
    .entry-title {
      color: var(--color-gray-100);
    }

    .resume-headline,
    .resume-contact,
    .resume-summary,
    .skill-row dd,
    .resume-closing p {
      color: var(--color-gray-300);
    }

    .resume-contact a {
      color: var(--color-primary-300);
    }

    .employer-tenure,
    .role-dates,
    .entry-detail,
    .entry-date,
    .cert-expired {
      color: var(--color-gray-400);
    }

    .employer-name {
      border-bottom-color: var(--color-gray-600);
    }

    .role-ladder > li,
    .skill-row,
    .entry {
      border-color: var(--color-gray-700);
    }

    .role-summary :global(.role-chevron) {
      color: var(--color-gray-400);
    }

    .role-summary:hover .role-title,
    .role-summary:hover :global(.role-chevron) {
      color: var(--color-primary-300);
    }

    .resume-download {
      border-color: var(--color-gray-600);
      background-color: var(--color-gray-800);
      color: var(--color-gray-100);
    }

    .resume-download:hover {
      border-color: var(--color-primary-300);
      color: var(--color-primary-200);
    }

    .resume-download-primary {
      border-color: var(--color-primary-600);
      background-color: var(--color-primary-600);
      color: #fff;
    }

    .resume-download-primary:hover {
      border-color: var(--color-primary-700);
      background-color: var(--color-primary-700);
      color: #fff;
    }

    .resume-closing p a {
      color: var(--color-primary-300);
    }

    .resume-closing {
      border-color: var(--color-gray-700);
      background-color: var(--color-gray-800);
    }

    .cert-expired {
      border-color: var(--color-gray-600);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .role-summary :global(.role-chevron),
    .role-title,
    .resume-download {
      transition: none;
    }
  }

  /* ============================================================
   * Mobile
   * ============================================================ */
  @media (max-width: 640px) {
    .role-summary {
      flex-wrap: wrap;
      row-gap: 0.1rem;
