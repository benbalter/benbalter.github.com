---
import PageLayout from "../layouts/PageLayout.astro";
import { siteConfig } from "../config";

const title = "Fine Print";
const description =
  "This is my personal Web site. The opinions expressed herein represent my own, and not those of any employer, group, or organization.";
---

<PageLayout title={title} description={description} noindex={true}>
  <div class="not-prose space-y-8">

    {/* Disclaimer Cards */}
    <div class="grid gap-4 md:grid-cols-2">
      <div id="personal-opinions" class="group scroll-mt-24 rounded-lg border border-gray-200 dark:border-gray-700 p-5">
        <div class="flex items-center gap-3 mb-1.5">
          <span class="text-xl shrink-0" aria-hidden="true">💬</span>
          <h2 class="text-base font-semibold text-gray-900 dark:text-gray-100 m-0">Personal opinions</h2>
          <a href="#personal-opinions" class="shrink-0 no-underline text-gray-400 dark:text-gray-500 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 transition-opacity hover:text-primary dark:hover:text-primary-300" aria-label="Link to Personal opinions">#</a>
        </div>
        <p class="text-sm text-gray-600 dark:text-gray-300 leading-relaxed m-0">
          This is my personal site. The opinions expressed herein represent my own, and not those of any employer, group, or organization.
        </p>
      </div>

      <div id="not-legal-advice" class="group scroll-mt-24 rounded-lg border border-gray-200 dark:border-gray-700 p-5">
        <div class="flex items-center gap-3 mb-1.5">
          <span class="text-xl shrink-0" aria-hidden="true">⚖️</span>
          <h2 class="text-base font-semibold text-gray-900 dark:text-gray-100 m-0">Not legal advice</h2>
          <a href="#not-legal-advice" class="shrink-0 no-underline text-gray-400 dark:text-gray-500 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 transition-opacity hover:text-primary dark:hover:text-primary-300" aria-label="Link to Not legal advice">#</a>
        </div>
        <p class="text-sm text-gray-600 dark:text-gray-300 leading-relaxed m-0">
          I am not an expert. My views do not constitute legal advice, nor is their validity, accuracy, currentness, or completeness guaranteed. If you need a lawyer, please find a licensed attorney in your state.
        </p>
      </div>

      <div id="affiliate-links" class="group scroll-mt-24 rounded-lg border border-gray-200 dark:border-gray-700 p-5">
        <div class="flex items-center gap-3 mb-1.5">
          <span class="text-xl shrink-0" aria-hidden="true">🛒</span>
          <h2 class="text-base font-semibold text-gray-900 dark:text-gray-100 m-0">Affiliate links</h2>
          <a href="#affiliate-links" class="shrink-0 no-underline text-gray-400 dark:text-gray-500 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 transition-opacity hover:text-primary dark:hover:text-primary-300" aria-label="Link to Affiliate links">#</a>
        </div>
        <p class="text-sm text-gray-600 dark:text-gray-300 leading-relaxed m-0">
          As an Amazon Associate I earn from qualifying purchases. Some external links, for example, book recommendations, may contain an affiliate code, meaning at no additional cost to you, I may earn a small commission if you click through and make a purchase.
        </p>
      </div>

      <div id="oxford-comma" class="group scroll-mt-24 rounded-lg border border-gray-200 dark:border-gray-700 p-5">
        <div class="flex items-center gap-3 mb-1.5">
          <span class="text-xl shrink-0" aria-hidden="true">✍️</span>
          <h2 class="text-base font-semibold text-gray-900 dark:text-gray-100 m-0">Oxford comma enthusiast</h2>
          <a href="#oxford-comma" class="shrink-0 no-underline text-gray-400 dark:text-gray-500 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 transition-opacity hover:text-primary dark:hover:text-primary-300" aria-label="Link to Oxford comma enthusiast">#</a>
        </div>
        <p class="text-sm text-gray-600 dark:text-gray-300 leading-relaxed m-0">
          I am a strong proponent of the <a href="https://en.wikipedia.org/wiki/Serial_comma" class="text-primary dark:text-primary-300 hover:text-primary-700 dark:hover:text-primary-200 underline">serial comma</a>, and, well, commas in general.
        </p>
      </div>

      <div id="em-dashes" class="group scroll-mt-24 rounded-lg border border-gray-200 dark:border-gray-700 p-5">
        <div class="flex items-center gap-3 mb-1.5">
          <span class="text-xl shrink-0" aria-hidden="true">➖</span>
          <h2 class="text-base font-semibold text-gray-900 dark:text-gray-100 m-0">Em dashes before they were (un)cool</h2>
          <a href="#em-dashes" class="shrink-0 no-underline text-gray-400 dark:text-gray-500 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 transition-opacity hover:text-primary dark:hover:text-primary-300" aria-label="Link to Em dashes before they were (un)cool">#</a>
        </div>
        <p class="text-sm text-gray-600 dark:text-gray-300 leading-relaxed m-0">
          I used em dashes before they were (un)cool—my favorite piece of punctuation, not proof a robot wrote this. They run through <a href="/2011/01/04/the-files-in-the-computer/" class="text-primary dark:text-primary-300 hover:text-primary-700 dark:hover:text-primary-200 underline">my very first posts in 2011</a> and <a href="/2014/03/31/word-versus-markdown-more-than-mere-semantics/" class="text-primary dark:text-primary-300 hover:text-primary-700 dark:hover:text-primary-200 underline">all the way through</a>, years before a language model made them suspicious.
        </p>
      </div>

      <div id="licensing" class="group scroll-mt-24 rounded-lg border border-gray-200 dark:border-gray-700 p-5">
        <div class="flex items-center gap-3 mb-1.5">
          <span class="text-xl shrink-0" aria-hidden="true">📄</span>
          <h2 class="text-base font-semibold text-gray-900 dark:text-gray-100 m-0">Licensing</h2>
          <a href="#licensing" class="shrink-0 no-underline text-gray-400 dark:text-gray-500 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 transition-opacity hover:text-primary dark:hover:text-primary-300" aria-label="Link to Licensing">#</a>
        </div>
        <p class="text-sm text-gray-600 dark:text-gray-300 leading-relaxed m-0">
          All original content is licensed under a <a rel="license" href="https://creativecommons.org/licenses/by/3.0/" class="text-primary dark:text-primary-300 hover:text-primary-700 dark:hover:text-primary-200 underline">Creative Commons Attribution 3.0 Unported License</a> attributable to {siteConfig.author}, other than <a href="/2026/03/04/thirteen-years-at-github/" class="text-primary dark:text-primary-300 hover:text-primary-700 dark:hover:text-primary-200 underline">the post "I've worked remotely at GitHub for thirteen years: here's what actually works"</a>. All code is available <a href={siteConfig.githubRepoUrl} class="text-primary dark:text-primary-300 hover:text-primary-700 dark:hover:text-primary-200 underline">on GitHub</a> under the MIT license.
        </p>
      </div>
    </div>
  </div>
</PageLayout>
