---
/**
 * Resume — Print / PDF source
 *
 * A standalone, print-only document that astro-pdf renders to `/resume.pdf`
 * (see the `pdf()` integration in astro.config.mjs). Deliberately NOT built on
 * BaseLayout: no site nav, footer, or chrome — just the résumé, laid out as a
 * bold two-column sheet (navy sidebar + flowing experience column) sized for
 * US Letter. The web résumé lives at `/resume/` and is unaffected.
 *
 * Content is shared with `/resume/` via `getResumePositions()` and the same
 * `pages/resume` collection entry, so the two surfaces can't drift.
 *
 * Styling builds on the Tailwind theme (color + font tokens from `@theme` in
 * global.css, plus Tailwind's preflight reset) but expresses the layout in a
 * scoped CSS block: print design needs precise pt/in units, and this project's
 * Tailwind v4 build drops `pt`-unit arbitrary utilities. Theme tokens keep the
 * palette in lockstep with the rest of the site.
 */

import { getEntry } from 'astro:content';
import { Font } from 'astro:assets';
import { RESUME_HEADLINE, getResumePositions, typographicApostrophes } from '../../utils/resume-data';
import '../../styles/global.css';

const resumePage = await getEntry('pages', 'resume');
if (!resumePage) throw new Error('Resume page data not found');
// Highlights are left out of the PDF: they restate role bullets, and the sheet
// targets two pages. The web résumé, .md, and .docx keep them.
const { degrees, certifications, skills, summary } = resumePage.data;

const { grouped: groupedPositions } = await getResumePositions();

// Print drops expired credentials as well as personal ones. The web page, the
// .md, and the .docx still list them with an "(expired)" marker; this is a
// two-page-target sheet and a lapsed credential is the first thing to cut.
// What's left renders as extra entries in the sidebar's Education section. A
// separate sidebar section overflows page 1 and drags the float onto page 2.
const professionalCerts = certifications.filter(
  (c: { category?: string; expired?: boolean }) =>
    (c.category ?? 'professional') === 'professional' && !c.expired,
);

// "Jul 2021": short months keep long role titles on one line beside the date.
const shortDate = (value: string) =>
  new Date(value).toLocaleDateString('en-US', { month: 'short', year: 'numeric', timeZone: 'UTC' });
const year = (value: string) => String(new Date(value).getUTCFullYear());

// Date range for a position, e.g. "Jul 2021 – Feb 2023" / "May 2026 – Present".
const dateRange = (start: string, end?: string) =>
  `${shortDate(start)} – ${end ? shortDate(end) : 'Present'}`;

// Skill runs for the sidebar: each item's middot separator is glued to it with
// a no-break space so a line never starts with "·", and hyphenated terms
// ("AI-accelerated") stay whole. A break at the hyphen reads badly and
// extracts as "AIaccelerated" in ATS parsers.
const skillParts = (items: string[]) =>
  items
    .map((item, i) => (i < items.length - 1 ? `${item}\u00a0·` : item))
    .join(' ')
    .split(/(\S*-\S*)/)
    .map((part, i) => ({ text: part, nowrap: i % 2 === 1 }));

const contact = [
  { label: 'Washington, DC', href: null, icon: 'pin' },
  { label: 'ben@balter.com', href: 'mailto:ben@balter.com', icon: 'mail' },
  { label: 'ben.balter.com', href: 'https://ben.balter.com', icon: 'globe' },
  { label: 'github.com/benbalter', href: 'https://github.com/benbalter', icon: 'github' },
  { label: 'linkedin.com/in/benbalter', href: 'https://www.linkedin.com/in/benbalter', icon: 'linkedin' },
];
---

<!doctype html>
<html lang="en-US" class="rp-root">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content="Print-optimized résumé source for Ben Balter, rendered to /resume.pdf." />
    <link rel="canonical" href="https://ben.balter.com/resume/print/" />
    <title>Ben Balter, Résumé</title>
    <Font cssVariable="--font-inter" />
    <Font cssVariable="--font-lora-static" />
  </head>
  <body class="rp">
    <!-- ================= Sidebar (navy column) ================= -->
    <aside class="rp-side">
      <header class="rp-id">
        <h1 class="rp-name">Ben Balter</h1>
        <p class="rp-role">{RESUME_HEADLINE}</p>
      </header>

      <ul class="rp-contact">
        {contact.map((c) => (
          <li>
            <svg class="rp-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              {c.icon === 'pin' && <><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" /><circle cx="12" cy="10" r="3" /></>}
              {c.icon === 'mail' && <><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 7 9 6 9-6" /></>}
              {c.icon === 'globe' && <><circle cx="12" cy="12" r="9" /><path d="M3 12h18M12 3a15 15 0 0 1 0 18 15 15 0 0 1 0-18z" /></>}
              {c.icon === 'github' && <path d="M9 19c-4 1.4-4-2-6-2m12 4v-3.4c0-1 .1-1.4-.5-2 2.8-.3 5.5-1.4 5.5-6a4.6 4.6 0 0 0-1.3-3.2 4.3 4.3 0 0 0-.1-3.2s-1-.3-3.4 1.3a11.5 11.5 0 0 0-6 0C6.6 2.3 5.6 2.6 5.6 2.6a4.3 4.3 0 0 0-.1 3.2A4.6 4.6 0 0 0 4 9c0 4.6 2.7 5.7 5.5 6-.6.6-.6 1.2-.5 2V21" />}
              {c.icon === 'linkedin' && <><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6z" /><rect x="2" y="9" width="4" height="12" /><circle cx="4" cy="4" r="2" /></>}
            </svg>
            {c.href ? <a href={c.href}>{c.label}</a> : <span>{c.label}</span>}
          </li>
        ))}
      </ul>

      {skills && skills.length > 0 && (
        <section class="rp-side-section">
          <h2 class="rp-side-h">Areas of focus</h2>
          {skills.map((group: { group: string; items: string[] }) => (
            <div class="rp-skill">
              <p class="rp-skill-name">{group.group}</p>
              <p class="rp-skill-items">{skillParts(group.items).map((part) => (part.nowrap ? <span class="rp-nowrap">{part.text}</span> : part.text))}</p>
            </div>
          ))}
        </section>
      )}

      {(degrees?.length > 0 || professionalCerts.length > 0) && (
        <section class="rp-side-section">
          <h2 class="rp-side-h">{professionalCerts.length > 0 ? 'Education and credentials' : 'Education'}</h2>
          {degrees?.map((d: { school: string; degree: string; date: string }) => (
            <div class="rp-edu">
              <p class="rp-edu-school">{d.school}</p>
              <p class="rp-edu-degree">{d.degree}</p>
              <p class="rp-edu-date">{year(d.date)}</p>
            </div>
          ))}
          {professionalCerts.map((c: { authority: string; name: string }) => (
            <div class="rp-edu">
              <p class="rp-edu-school">{c.authority}</p>
              <p class="rp-edu-degree">{c.name}</p>
            </div>
          ))}
        </section>
      )}
    </aside>

    <!-- ================= Main column (flows across pages) ================= -->
    <div class="rp-main">
      {summary && <p class="rp-summary">{typographicApostrophes(summary)}</p>}

      <section class="rp-main-section">
        <h2 class="rp-main-h">Experience</h2>
        {groupedPositions.map((group) => (
          <div class="rp-emp">
            <h3 class="rp-emp-name">{group.employer}</h3>
            {group.positions.map((position) => (
              <div class="rp-pos">
                <div class="rp-pos-head">
                  <h4 class="rp-pos-title">{position.data.title}</h4>
                  <span class="rp-pos-date">{dateRange(position.data.start_date, position.data.end_date)}</span>
                </div>
                <div class="pos-content rp-dots" data-print-bullets={position.data.print_bullets}>
                  <position.Content />
                </div>
              </div>
            ))}
          </div>
        ))}
      </section>

    </div>
  </body>
</html>

<style is:global>
  /* ============================================================
   * Document plumbing (paged-media geometry + full-bleed stripe)
   * This page is a standalone document rendered only to PDF, so
   * global rules here can't leak into the rest of the site.
   * ============================================================ */
  :root {
    --rp-side: 2.4in; /* navy sidebar width (page 1 only) */
    --rp-gap: 0.32in; /* gutter between sidebar and experience column */
    --rp-navy: var(--color-brand-950);
  }

  @page {
    size: Letter;
    /* Left/right margins 0 so the page-1 navy panel reaches the left edge;
       top/bottom margins give every page breathing room. */
    margin: 0.5in 0;

    /* Running header on continuation pages, so a loose printed sheet still
       says whose it is. Margin boxes sit in the 0.5in top margin; the right
       page margin is 0, so padding supplies the inset. */
    @top-right {
      content: 'Ben Balter · Page ' counter(page) ' of ' counter(pages);
      padding-right: 0.5in;
      font-family: var(--font-sans);
      font-size: 7.5pt;
      letter-spacing: 0.04em;
      color: var(--color-gray-600);
    }
  }

  @page :first {
    @top-right {
      content: none;
    }
  }

  html.rp-root {
    /* Thin navy spine on every sheet (the root background paints the page canvas
       edge-to-edge). Page 1's full sidebar panel sits flush over it (same navy);
       continuation pages show just this rule at the left edge, so the brand
       persists without a full band. */
    background: linear-gradient(to right, var(--rp-navy) 0 8px, #ffffff 8px);
    print-color-adjust: exact;
    -webkit-print-color-adjust: exact;
  }

  body.rp {
    margin: 0;
    /* Transparent, and it must be set explicitly. The navy spine lives on
       html.rp-root and propagates to the page canvas, which covers the full
       sheet including the @page margins. Any opaque body background paints over
       that canvas wherever body's box reaches, leaving the spine visible only in
       the 0.5in top and bottom margin strips: a stray navy dash at the top-left
       and bottom-left of every continuation page. Simply dropping the property
       does not work — global.css then applies its own body background (dark in
       the site theme), which is still opaque. The gradient's second stop
       supplies the white paper. */
    background: transparent;
    font-family: var(--font-sans);
    color: var(--color-gray-900);
    print-color-adjust: exact;
    -webkit-print-color-adjust: exact;
  }

  /* Override global.css base `p { hyphens: auto }` everywhere in the document:
     on these narrow measures it broke "produc-tivity", "compli-ance", and
     "onboard-ing". Ragged-right reads cleaner. */
  .rp :is(p, li) {
    hyphens: none;
  }

  /* Glossary acronyms (.initialism) get a dotted bottom border on the site to
     signal a tooltip. Paper has no tooltips, so it just reads as a broken
     link. nowrap keeps terms like "M-10-22" from splitting at a hyphen. */
  .rp abbr {
    border-bottom: 0;
    text-decoration: none;
    white-space: nowrap;
  }

  /* Neutralize the site's aggressive base heading styles (clamp() sizes, 2em
     top margins, balance) for this document; every heading is sized locally.
     :where() keeps this at single-class specificity so the per-heading rules
     below (weights, tracking, margins) win by source order. With :is() it
     outranked them, and the PDF lost every bold weight and heading margin. */
  .rp :where(h1, h2, h3, h4) {
    margin: 0;
    line-height: 1.2;
    letter-spacing: normal;
    text-wrap: initial;
    font-weight: 600;
  }

  /* global.css sets line-height 1.7 and padding directly on every li, which
     beat the 1.3 leading inherited from each list and double-spaced bullets. */
  .rp li {
    line-height: inherit;
    padding-left: 0;
  }

  .rp-nowrap {
    white-space: nowrap;
  }

  /* ============================================================
   * Sidebar: a floated navy panel on page 1 only. Experience flows
   * to its right, then goes full-width once the panel ends. Heading
   * rules use flow-root to sit beside the float, so the panel needs no
   * z-index (which also kept it in normal paint order, so PDF text
   * extraction reads the name and contact details first). min-height
   * fills the page-1 content box; the panel's content must fit within
   * one page (a float that overflows would drag onto page 2).
   * ============================================================ */
  .rp-side {
    float: left;
    width: var(--rp-side);
    min-height: 10in;
    margin-right: var(--rp-gap);
    padding: 0.14in 0.24in 0.08in;
    background: var(--rp-navy);
    color: #fff;
    print-color-adjust: exact;
    -webkit-print-color-adjust: exact;
  }

  .rp-name {
    font-size: 24pt;
    font-weight: 700;
    line-height: 1.03;
    /* Tight tracking shrank the word gap enough that PDF text extraction
       read the name as "BenBalter"; the word-spacing restores it. */
    letter-spacing: -0.02em;
    word-spacing: 0.12em;
    color: #fff;
  }

  /* Normal case and tracking: letter-spaced caps extracted as "S E C U R I T Y"
     and hid the positioning keywords from applicant-tracking parsers. */
  .rp-role {
    margin-top: 5pt;
    font-size: 9pt;
    font-weight: 500;
    line-height: 1.35;
    color: var(--color-primary-200);
  }

  .rp-contact {
    margin: 0.2in 0 0;
    padding: 0;
    list-style: none;
  }

  .rp-contact li {
    display: flex;
    align-items: center;
    gap: 7pt;
    margin-bottom: 5pt;
    font-size: 7.75pt;
    line-height: 1.25;
    color: rgba(255, 255, 255, 0.85);
  }

  .rp-contact a {
    color: inherit;
    text-decoration: none;
  }

  .rp-icon {
    width: 11px;
    height: 11px;
    flex: 0 0 auto;
    color: var(--color-primary-300);
  }

  .rp-side-section {
    margin-top: 0.14in;
    padding-top: 0.12in;
    border-top: 1px solid rgba(255, 255, 255, 0.16);
  }

  .rp-side-h {
    margin-bottom: 5pt;
    font-size: 9pt;
    font-weight: 700;
    color: var(--color-primary-200);
  }

  /* Skills */
  .rp-skill {
    margin-bottom: 5pt;
  }

  .rp-skill-name {
    margin: 0;
    font-size: 8.5pt;
    font-weight: 600;
    color: #fff;
  }

  .rp-skill-items {
    margin: 1pt 0 0;
    font-size: 8pt;
    line-height: 1.4;
    color: rgba(255, 255, 255, 0.72);
  }

  /* Education */
  .rp-edu {
    margin-bottom: 6pt;
  }

  .rp-edu-school {
    margin: 0;
    text-wrap: wrap; /* global "pretty" broke "The George / Washington University" */
    font-size: 8.5pt;
    font-weight: 600;
    line-height: 1.25;
    color: #fff;
  }

  .rp-edu-degree {
    margin: 1pt 0 0;
    font-size: 7.75pt;
    line-height: 1.3;
    color: rgba(255, 255, 255, 0.72);
  }

  .rp-edu-date {
    margin: 1.5pt 0 0;
    font-size: 7.75pt;
    font-variant-numeric: tabular-nums;
    color: var(--color-primary-300);
  }

  /* ============================================================
   * Main column — offset past the stripe; flows across pages.
   * ============================================================ */
  /* Main column flows around the floated sidebar on page 1 (line boxes shift
     right of the panel), then spans full width on continuation pages. The
     0.5in side padding sets the full-width margins on pages 2+; on page 1 the
     sidebar's width + gutter already inset the text further. */
  .rp-main {
    padding: 0.02in 0.5in 0.2in;
  }

  /* Lora from a static (non-variable) file: Chromium embeds a variable font
     as a Type 3 bitmap-style font, which some viewers and ATS parsers mangle. */
  .rp-summary {
    margin: 0 0 0.18in;
    font-family: var(--font-lora-static), Georgia, serif;
    font-size: 10.5pt;
    line-height: 1.5;
    color: var(--color-gray-800);
  }

  .rp-main-section {
    margin-bottom: 0.11in;
  }

  /* flow-root makes the heading box sit beside the page-1 float instead of
     running under it, so its rule starts at the text edge, not the sidebar's. */
  .rp-main-h {
    display: flow-root;
    margin-bottom: 7pt;
    padding: 0 0 3pt;
    font-size: 12pt;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--rp-navy);
    border-bottom: 1.5px solid var(--color-primary-700);
  }

  .rp-emp {
    margin-bottom: 7pt;
  }

  .rp-emp-name {
    display: flow-root;
    margin-bottom: 5pt;
    padding-bottom: 3pt;
    font-size: 11.5pt;
    font-weight: 700;
    color: var(--color-gray-900);
    border-bottom: 1px solid var(--color-gray-200);
    /* Keep the employer heading with its first role rather than stranding it
       at the foot of a page. Content itself is free to break across pages so
       positions flow densely instead of each being shoved to a fresh sheet. */
    break-after: avoid;
  }

  .rp-pos {
    margin-bottom: 4pt;
  }

  /* Roles may split across sheets (keeping them whole left a quarter of page 1
     empty), but never strand a lone bullet line at either side of the break. */
  .pos-content li {
    orphans: 2;
    widows: 2;
    break-inside: avoid;
  }

  .rp-pos-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12pt;
    break-after: avoid;
  }

  .rp-pos-title {
    text-wrap: balance;
    font-size: 10pt;
    font-weight: 600;
    color: var(--color-gray-900);
  }

  .rp-pos-date {
    flex: 0 0 auto;
    font-size: 8.5pt;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    color: var(--color-primary-600);
  }

  /* Rendered markdown inside each position (bulleted accomplishments) */
  .pos-content {
    margin-top: 2.5pt;
    font-size: 9.25pt;
    line-height: 1.3;
    color: var(--color-gray-700);
  }

  /* No list indent: page 1 drops it under the float anyway, so bullets hang
     in the gutter and text aligns with the heading edge on every page. */
  .rp-dots ul {
    margin: 0;
    padding-left: 0;
    list-style: none;
  }

  .pos-content li {
    margin-bottom: 2pt;
  }

  /* `print_bullets: N` in a role's front matter (content.config.ts) keeps only
     its first N bullets on this sheet; every other surface shows them all.
     nth-child can't read an attribute, so each supported N gets a rule. */
  .pos-content[data-print-bullets='1'] > ul > li:nth-child(n + 2),
  .pos-content[data-print-bullets='2'] > ul > li:nth-child(n + 3),
  .pos-content[data-print-bullets='3'] > ul > li:nth-child(n + 4),
  .pos-content[data-print-bullets='4'] > ul > li:nth-child(n + 5) {
    display: none;
  }

  /* Inline-block dot (not absolute) so the bullet rides the line box and stays
     beside the text when it's float-shifted on page 1. An absolute dot anchors
     to the li's far-left edge, which hides behind the navy panel. */
  .rp-dots li::before {
    content: '';
    display: inline-block;
    width: 3px;
    height: 3px;
    margin-left: -12pt;
    margin-right: calc(12pt - 3px);
    vertical-align: middle;
    border-radius: 9999px;
    background: var(--color-primary-500);
  }

  .pos-content p {
    margin: 0 0 4pt;
  }

  .pos-content strong {
    font-weight: 600;
    color: var(--color-gray-900);
  }

  .pos-content a {
    color: var(--color-primary-600);
    text-decoration: underline;
    text-underline-offset: 1.5px;
  }

</style>
