---
/**
 * 404 Not Found Page
 *
 * Displays a helpful 404 page with:
 * - Suggestion for similar URLs based on string similarity (Levenshtein distance)
 * - Search button to open the site's Pagefind search modal
 * - List of popular blog posts (from config)
 * - List of recent blog posts
 *
 * The similar URL suggestion is populated client-side by fetching the sitemap.xml
 * and finding the closest match to the requested URL.
 */

import BaseLayout from '../layouts/BaseLayout.astro';
import { popularPostSlugs } from '../config';
import { getPostUrl } from '../utils/post-urls';
import { pickPostsBySlug } from '../utils/post-filtering';
import { getPublishedPosts } from '../utils/posts';
import SubscribeCta from '../components/SubscribeCta.astro';

const title = 'Page not found';
const description = 'The page you are trying to view does not exist.';

// Published, non-archived posts, newest first
const allPosts = await getPublishedPosts({ sorted: true });

// Recent posts: top 3 most recent
const recentPosts = allPosts.slice(0, 3);

// Popular posts: resolve slugs from config, preserving config order
const popularPosts = pickPostsBySlug(allPosts, popularPostSlugs);
---

<BaseLayout title={title} description={description} noindex={true}>
  <div class="max-w-4xl mx-auto px-4 py-8">
    <h1 class="text-3xl font-bold text-gray-900 dark:text-gray-100 mb-4">Page not found</h1>

    <div class="p-6 mb-8 rounded-xl border border-primary/20 dark:border-primary/30 bg-white dark:bg-gray-800">
      <p class="text-lg text-gray-700 dark:text-gray-300 mb-2">The page you're looking for doesn't exist or has been moved.</p>
      <p class="text-base font-semibold text-gray-900 dark:text-gray-100 mb-4" hidden>
        Perhaps you're looking for <span id="four-oh-four-suggestion" aria-live="polite" class="text-primary dark:text-primary-300"></span>?
      </p>
      <button
        data-search-open
        type="button"
        class="inline-flex items-center gap-2 rounded-lg border border-primary text-primary px-5 py-2.5 text-sm font-medium hover:bg-primary hover:text-white dark:border-primary-300 dark:text-primary-300 dark:hover:bg-primary-300 dark:hover:text-gray-900 transition-colors duration-200"
      >
        <svg width="16" height="16" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path d="M8.5 3a5.5 5.5 0 014.383 8.823l4.147 4.147a.75.75 0 01-1.06 1.06l-4.147-4.147A5.5 5.5 0 118.5 3zm0 1.5a4 4 0 100 8 4 4 0 000-8z" fill="currentColor"/>
        </svg>
        Search for what you're looking for
      </button>
    </div>

    <h2 class="text-2xl font-semibold text-gray-900 dark:text-gray-100 mb-4">Popular posts</h2>

    <div class="space-y-3 mb-8">
      {popularPosts.map((post) => {
        const postUrl = getPostUrl(post.id);
        return (
          <div class="group relative rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 p-4 transition-all duration-200 hover:border-primary/40 dark:hover:border-primary-400/40 hover:shadow-sm">
            <a href={postUrl} class="text-gray-900 dark:text-gray-100 no-underline font-medium group-hover:text-primary dark:group-hover:text-primary-300 transition-colors duration-200 before:absolute before:inset-0">
              {post.data.title}
            </a>
          </div>
        );
      })}
    </div>

    <h2 class="text-2xl font-semibold text-gray-900 dark:text-gray-100 mb-4">Recent posts</h2>

    <div class="space-y-3">
      {recentPosts.map((post) => {
        const postUrl = getPostUrl(post.id);
        return (
          <div class="group relative rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 p-4 transition-all duration-200 hover:border-primary/40 dark:hover:border-primary-400/40 hover:shadow-sm">
            <a href={postUrl} class="text-gray-900 dark:text-gray-100 no-underline font-medium group-hover:text-primary dark:group-hover:text-primary-300 transition-colors duration-200 before:absolute before:inset-0">
              {post.data.title}
            </a>
          </div>
        );
      })}
    </div>

    <div class="mt-8">
      <SubscribeCta />
    </div>
  </div>

  <!-- Client-side script to fetch sitemap and suggest similar URL -->
  <script>
    import { closestPath } from '../utils/closest-path';

    const FETCH_TIMEOUT_MS = 2000;

    const suggestionSpan = document.getElementById('four-oh-four-suggestion');
    if (suggestionSpan) {

      const controller = new AbortController();
      const timeoutId = setTimeout(() => controller.abort(), FETCH_TIMEOUT_MS);

      try {
        const response = await fetch(
          `${window.location.protocol}//${window.location.host}/sitemap-0.xml`,
          { signal: controller.signal },
        );

        if (!response.ok) throw new Error(`HTTP ${response.status}`);

        const text = await response.text();
        const xml = new DOMParser().parseFromString(text, 'application/xml');

        // Compare paths, not full URLs: the sitemap's host differs from a
        // preview or local host, and that difference would swamp the match.
        const paths = Array.from(xml.querySelectorAll('urlset > url > loc'))
          .map((el) => new URL(el.textContent || '/', window.location.origin).pathname);

        const path = closestPath(window.location.pathname, paths);
        if (!path) throw new Error('No URLs found');

        // Create link element safely (avoid XSS)
        const link = document.createElement('a');
        link.href = path;
        link.textContent = path;
        suggestionSpan.replaceChildren(link);

        // The paragraph ships hidden so readers never see an empty
        // "looking for ?"; reveal it only once there's a suggestion.
        const parent = suggestionSpan.closest('p');
        if (parent) parent.hidden = false;
      } catch {
        // On any error (timeout, network, parse), the suggestion stays hidden
      } finally {
        clearTimeout(timeoutId);
      }
    }
  </script>
</BaseLayout>
