---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import PostLayout from '../../../../layouts/PostLayout.astro';
import { findRelatedPosts, initializeRelatedPostsCache } from '../../../../utils/related-posts';
import { getPostUrl, parsePostId } from '../../../../utils/post-urls';
import { isPublished, isListablePost } from '../../../../utils/post-filtering';
import { buildLastmodIndex, lastmodForUrl } from '../../../../utils/sitemap-lastmod';
import { siteConfig } from '../../../../config';

// Generate static paths for all blog posts with Jekyll URL structure.
// Archived posts are published (with a warning banner) and must be built, so
// route generation uses `isPublished` — not the stricter listing predicate.
export async function getStaticPaths() {
  const posts = await getCollection('posts', isPublished);

  // Initialize the related posts cache once for all posts
  // This pre-calculates TF-IDF vectors for all posts to avoid redundant computation
  initializeRelatedPostsCache(posts);

  // Git-based last-modified dates, shared with the sitemap's <lastmod> so
  // dateModified and article:modified_time agree with it.
  const lastmodIndex = buildLastmodIndex();

  return posts.map((post: CollectionEntry<'posts'>) => {
    // Extract date from id (YYYY-MM-DD-slug format)
    const parts = parsePostId(post.id);
    
    if (parts) {
      const lastmod = lastmodForUrl(`${siteConfig.url}${getPostUrl(post.id)}`, lastmodIndex);
      return {
        params: parts,
        props: { post, allPosts: posts, lastmod },
      };
    }
    
    // Fallback for posts without date in id
    console.warn(`Post ${post.id} does not match expected format YYYY-MM-DD-slug`);
    return null;
  }).filter(Boolean);
}

interface Props {
  post: CollectionEntry<'posts'>;
  allPosts: CollectionEntry<'posts'>[];
  lastmod?: string | undefined;
}

const { post, allPosts, lastmod } = Astro.props;
const { Content, headings } = await render(post);

// Extract date from params for display (use URL params to ensure consistency with the route)
const { year, month, day, slug } = Astro.params;
const pubDate = new Date(parseInt(year), parseInt(month) - 1, parseInt(day));

// Only report a modification when it lands on a later day than publication;
// the commit that adds a post is its publish, not an update.
const lastmodDate = lastmod ? new Date(lastmod) : undefined;
const updatedDate = lastmodDate && lastmodDate.getTime() - pubDate.getTime() >= 24 * 60 * 60 * 1000
  ? lastmodDate
  : undefined;

// Generate OG image URL for this post
// If post has a custom image, use that, otherwise use the dynamically generated one
const ogImageUrl = post.data.image || `/og/${year}/${month}/${day}/${slug}.png`;

// Related posts and sequential navigation only consider listable (non-archived)
// posts, so archived posts stay reachable but are never surfaced as suggestions
// and don't appear in the prev/next chain between current posts.
const listablePosts = allPosts.filter(isListablePost);

// Related posts: one "up next" card plus a short list. Kept to 4 so the end of
// the post leads with sharing and the book rather than a wall of exit links.
// When this post shows a BookCta, drop book-announcement posts before limiting,
// so they don't duplicate the CTA and the list still fills to 4.
const relatedCandidates = post.data.hideBookCta
  ? listablePosts
  : listablePosts.filter((p) => !siteConfig.bookAnnouncementPostIds.includes(p.id));
const relatedPosts = await findRelatedPosts(post, relatedCandidates, 4);
---

<PostLayout
  title={post.data.title}
  description={post.data.description}
  tldr={post.data.tldr}
  pubDate={pubDate}
  updatedDate={updatedDate}
  image={ogImageUrl}
  relatedPosts={relatedPosts}
  archived={post.data.archived}
  hideBookCta={post.data.hideBookCta}
  writtenAtGitHub={post.data.writtenAtGitHub}
  bookCtaVariant={post.data.bookCtaVariant}
  bookRelation={post.data.bookRelation}
  robots={post.data.robots}
  postId={post.id}
  headings={headings}
  postFilePath={post.filePath}
  posts={post.data.posts}
  roles={post.data.roles}
>
  <Content />
</PostLayout>
