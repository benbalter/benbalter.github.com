---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPostUrl } from '../utils/post-urls';
import { getPublishedPosts } from '../utils/posts';
import { pickPostsBySlug } from '../utils/post-filtering';
import { getPostMetadata } from '../utils/post-metadata';
import PostCard from '../components/PostCard.astro';
import YearJumpNav from '../components/YearJumpNav.astro';
import YearSections from '../components/YearSections.astro';
import { groupPostsByYear } from '../utils/posts-by-year';
import PopularPosts from '../components/PopularPosts.astro';
import { popularPostSlugs, siteConfig } from '../config';
import { generateCollectionPageSchema, schemaToJsonLd } from '../utils/structured-data';

const title = 'Posts';
const description = 'Blog posts by Ben Balter on developer platforms, open source, product and engineering leadership, and remote work, from practical management advice to how GitHub works.';

const posts = await getPublishedPosts({ sorted: true });

const popularPosts = pickPostsBySlug(posts, popularPostSlugs);

const { years, postsByYear } = groupPostsByYear(posts);

const collectionSchema = generateCollectionPageSchema({
  name: title,
  description,
  url: new URL('/posts/', siteConfig.url).toString(),
  posts: posts.map(post => ({
    url: new URL(getPostUrl(post.id), siteConfig.url).toString(),
    title: post.data.title,
  })),
});
---

<BaseLayout title={title} description={description}>
  <header class="mb-8">
    <h1 class="text-3xl md:text-4xl font-bold leading-tight text-gray-900 dark:text-gray-100">{title}</h1>
    <p class="text-gray-600 dark:text-gray-300">{posts.length} posts. For what I wrote while I worked at GitHub, see <a href="/github-years/">my GitHub years</a>.</p>
  </header>

  <YearJumpNav years={years} />

  {popularPosts.length > 0 && (
    <section class="mb-12">
      <h2 class="text-xl font-semibold text-gray-900 dark:text-gray-100 mb-4">Start here</h2>
      <div class="flex flex-wrap -mx-2">
        {popularPosts.map((post) => {
          const { postUrl, date, isoDate, readingTime, isExternal } = getPostMetadata(post);
          return (
            <div class="w-full md:w-1/2 lg:w-1/3 px-2 mb-3">
              <PostCard
                variant="featured"
                title={post.data.title}
                url={postUrl}
                date={date}
                isoDate={isoDate}
                description={post.data.description}
                readingTime={readingTime}
                external={isExternal}
              />
            </div>
          );
        })}
      </div>
    </section>
  )}

  {/* Book-announcement posts stay out of "Most read" for the same reason they
      stay off the homepage: the book shouldn't crowd out the writing. */}
  <PopularPosts exclude={[...popularPostSlugs, ...siteConfig.bookAnnouncementPostIds]} />

  <YearSections years={years} postsByYear={postsByYear} />
  <script type="application/ld+json" set:html={schemaToJsonLd(collectionSchema)} is:inline></script>
</BaseLayout>
