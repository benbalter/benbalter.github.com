---
/**
 * Bookmarklets Page
 *
 * Install links for my bookmarklets, built from
 * https://github.com/benbalter/bookmarklets. Data (and the vendored, built
 * code) is in src/data/bookmarklets.ts.
 *
 * The install links can't run from this page: the per-page CSP blocks
 * `javascript:` navigation. That's fine, since they're meant to be dragged to
 * the bookmarks bar and run on other sites.
 */

import PageLayout from '../layouts/PageLayout.astro';
import { bookmarklets, bookmarkletHref } from '../data/bookmarklets';

const title = 'Bookmarklets';
const description =
  'Small browser bookmarklets I use every day: copy a Markdown link to the GitHub issue you’re viewing, jump to the next page by incrementing the number at the end of the URL, reload a page without the cache, or toggle between a GitHub Pages site and its source.';
---

<PageLayout title={title} description={description}>
  <p>
    To install one, drag its button to your browser’s bookmarks bar. Then click the bookmark while you’re on the page you want to use it on. (Clicking the button here won’t do anything.)
  </p>

  <div class="not-prose mt-8 grid gap-4 md:grid-cols-2">
    {bookmarklets.map((bookmarklet) => (
      <section id={bookmarklet.id} class="group scroll-mt-24 rounded-lg border border-gray-200 dark:border-gray-700 p-5">
        <div class="flex items-center gap-3 mb-1.5">
          <h2 class="text-base font-semibold text-gray-900 dark:text-gray-100 m-0">{bookmarklet.name}</h2>
          <a href={`#${bookmarklet.id}`} class="shrink-0 no-underline text-gray-400 dark:text-gray-500 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 transition-opacity hover:text-primary dark:hover:text-primary-300" aria-label={`Link to ${bookmarklet.name}`}>#</a>
        </div>
        <p class="text-sm text-gray-600 dark:text-gray-300 leading-relaxed m-0">{bookmarklet.description}</p>
        <p class="mt-4 mb-0 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm">
          <a
            href={bookmarkletHref(bookmarklet.code)}
            class="btn inline-block cursor-grab rounded-full border border-primary bg-primary px-4 py-1.5 font-medium text-white no-underline active:cursor-grabbing dark:border-primary-400 dark:bg-primary-400 dark:text-gray-900"
            title={`Drag “${bookmarklet.name}” to your bookmarks bar`}
            data-bookmarklet={bookmarklet.id}
          >
            {bookmarklet.name}
          </a>
          {bookmarklet.repo && (
            <a href={bookmarklet.repo} class="text-primary dark:text-primary-300 hover:text-primary-700 dark:hover:text-primary-200 underline">
              Source on GitHub
            </a>
          )}
        </p>
      </section>
    ))}
  </div>

  <h2 id="limitations">Limitations</h2>
  <ul>
    <li>Browsers only allow clipboard writes right after a user action, so Copy issue link has to be clicked from the bookmarks bar.</li>
    <li>Pages toggle works by reading the URL, so it can’t recognize GitHub Pages sites on custom domains.</li>
    <li>Some sites’ Content Security Policy blocks bookmarklets in Firefox.</li>
    <li>They’re tested in Chromium and Firefox. They may work in other browsers, but I haven’t checked.</li>
  </ul>

  <p>
    The source and tests are in <a href="https://github.com/benbalter/bookmarklets">benbalter/bookmarklets</a>.
  </p>
</PageLayout>
