---
import PageLayout from '../layouts/PageLayout.astro';
import { siteConfig, networkLinks } from '../config';
import { Image } from 'astro:assets';
import headshotImage from '../../assets/img/headshot.jpg';
import BookCta from '../components/BookCta.astro';
import StartHere from '../components/StartHere.astro';
import { getBioParagraphs, aboutContent } from '../content/about-bio';
import { RESUME_HEADLINE } from '../utils/resume-data';

const title = 'About Ben Balter';
const description = siteConfig.aboutDescription;

// The shared bio (also the post-footer mini-bio, about.md, and llms.txt)
// restates things this page already shows: the book (the facts list and the
// closing card), the degrees (the facts list), and the résumé (the "View
// résumé" button). Cut those sentences here only. Each cut throws if its
// sentence is gone, so a bio edit can't silently bring the repetition back.
const pageOnlyCuts = [
  ' I wrote [Open and Async](https://open-and-async.com/?utm_source=benbalter-bio), the playbook for remote and distributed teams, and shipped an MCP server alongside it so agents can query it directly.',
  'I hold a J.D. and M.B.A. from the George Washington University and am a member of the DC Bar. ',
  ' [Full résumé](/resume/).',
];
const aboutPageBio = pageOnlyCuts.reduce((bio, sentence) => {
  if (!bio.includes(sentence)) {
    throw new Error(`about.astro: bio no longer contains ${JSON.stringify(sentence)}; update pageOnlyCuts`);
  }
  return bio.replace(sentence, '');
}, aboutContent);
const bioParagraphs = getBioParagraphs(aboutPageBio);

// Same-origin copy (built by script/build-headshots), so `download` works.
const headshotUrl = '/assets/img/headshot.jpg';

---

<PageLayout title={title} description={description} heading={RESUME_HEADLINE}>
  {/* Above the fold: who Ben is, in a form a recruiter can scan in seconds.
      The headline is the h1 (the nav already names Ben, so "About Ben
      Balter" stays in <title> only), and the same line leads the résumé. */}
  <Fragment slot="header-extra">
    <dl class="mt-6 grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-3 text-sm leading-normal m-0">
      <div>
        <dt class="font-medium text-gray-600 dark:text-gray-400">GitHub</dt>
        <dd class="m-0 text-gray-900 dark:text-gray-100">A decade on developer platforms and trust and safety, most recently as a director</dd>
      </div>
      <div>
        <dt class="font-medium text-gray-600 dark:text-gray-400">Book</dt>
        <dd class="m-0 text-gray-900 dark:text-gray-100">
          <a href={siteConfig.bookUrl} class="text-primary dark:text-primary-300 underline decoration-primary/40 underline-offset-2 hover:decoration-primary"><cite class="not-italic">Open and Async</cite></a>, the playbook for remote and distributed teams
        </dd>
      </div>
      <div>
        <dt class="font-medium text-gray-600 dark:text-gray-400">Education</dt>
        <dd class="m-0 text-gray-900 dark:text-gray-100">JD and MBA, George Washington University; DC Bar member</dd>
      </div>
      <div>
        <dt class="font-medium text-gray-600 dark:text-gray-400">Based in</dt>
        <dd class="m-0 text-gray-900 dark:text-gray-100">Washington, DC</dd>
      </div>
    </dl>

    <div class="mt-6 flex flex-wrap gap-3">
      <a href="/resume/" class="btn btn-primary">View résumé</a>
      <a href="#contact" class="btn btn-secondary">Get in touch</a>
    </div>
  </Fragment>

  {/* Phones already show Ben's face in the nav avatar, so the photo only
      appears from sm up, where it sits beside the header. */}
  <Image
    slot="header-aside"
    src={headshotImage}
    alt={`${siteConfig.author} headshot`}
    width={176}
    height={176}
    widths={[176, 352]}
    sizes="176px"
    loading="lazy"
    class="hidden sm:block w-[176px] shrink-0 rounded-lg"
  />

  {/* The bio fills PageLayout's column, which is the site's post measure. */}
  {bioParagraphs.map((para: string) => (
    <p set:html={para}></p>
  ))}

  <StartHere />

  <section id="contact" aria-labelledby="contact-heading" class="not-prose font-sans mt-10 pt-8 border-t border-gray-200 dark:border-gray-700 scroll-mt-24">
    <h2 id="contact-heading" class="text-xl font-bold text-gray-900 dark:text-gray-100 mb-3">Get in touch</h2>
    <p class="text-gray-700 dark:text-gray-300 m-0">
      Email is the best way to reach me: <a href={`mailto:${siteConfig.email}`} class="font-medium text-primary dark:text-primary-300 underline decoration-primary/40 underline-offset-2 hover:decoration-primary">{siteConfig.email}</a>.
      I'm also on {networkLinks.map((link, i) => (
        <>{i > 0 && (i === networkLinks.length - 1 ? ', and ' : ', ')}<a href={link.url} rel="me" class="font-medium text-primary dark:text-primary-300 underline decoration-primary/40 underline-offset-2 hover:decoration-primary">{link.name}</a></>
      ))}.
    </p>
    <ul class="mt-4 flex flex-wrap gap-x-6 gap-y-1 list-none p-0 m-0 text-sm [&>li]:p-0">
      <li><a href="/vcard.vcf" class="inline-flex min-h-[44px] items-center text-gray-700 dark:text-gray-300 hover:text-primary dark:hover:text-primary-300">Add to contacts</a></li>
      <li><a href="/subscribe/" class="inline-flex min-h-[44px] items-center text-gray-700 dark:text-gray-300 hover:text-primary dark:hover:text-primary-300">Get new posts by email</a></li>
      <li><a href={headshotUrl} download="ben-balter-headshot.jpg" class="inline-flex min-h-[44px] items-center text-gray-700 dark:text-gray-300 hover:text-primary dark:hover:text-primary-300">Download headshot (JPG)</a></li>
      <li><a href="/contact/#pgp" class="inline-flex min-h-[44px] items-center text-gray-700 dark:text-gray-300 hover:text-primary dark:hover:text-primary-300">PGP key</a></li>
    </ul>
  </section>

  {/* End on the book: the site's main conversion goal, and the last thing
      a visitor sees (peak-end). */}
  <div class="mt-10">
    <BookCta variant="featured" />
  </div>
</PageLayout>
