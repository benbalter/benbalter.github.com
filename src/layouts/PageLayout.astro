---
/**
 * Page Layout
 *
 * Layout for static pages (e.g., About, Contact, Resume).
 * Simpler than the PostLayout, focused on content presentation.
 * Uses Tailwind CSS utility classes for maintainability.
 *
 * Every page gets the same header: an h1 at DESIGN.md's display step (the
 * base `h1` rule in global.css sets the size, leading, and tracking, so pages
 * can't drift; phones step down to the headline token), an optional lede, and
 * optional extras below them.
 *
 * Slots:
 * - `heading`: rich h1 content (e.g. the résumé's name plus an sr-only
 *   title). Plain text should use the `heading` prop instead.
 * - `lede`: one short line under the h1 (Inter, gray, body-large).
 * - `header-extra`: page-specific header content below the lede (About's
 *   facts and buttons, the résumé's contact row and downloads).
 * - `header-aside`: content beside the header from `sm` up (About's photo).
 */

import BaseLayout from './BaseLayout.astro';

interface Props {
  /** Document <title> and, unless `heading` is set, the visible h1. */
  title: string;
  description: string;
  /** Visible h1 text when it should differ from the document title (the nav
      already names Ben, so pages don't repeat "Ben Balter" in their h1). */
  heading?: string;
  image?: string;
  noindex?: boolean;
  robots?: string | undefined;
  suppressPersonSchema?: boolean;
}

const {
  title,
  description,
  heading,
  image,
  noindex = false,
  robots,
  suppressPersonSchema = false,
} = Astro.props;

const hasAside = Astro.slots.has('header-aside');
---

<BaseLayout
  title={title}
  description={description}
  image={image}
  noindex={noindex}
  robots={robots}
  suppressPersonSchema={suppressPersonSchema}
>
  {/* Same centered 42rem column as PostLayout, so moving from a post to a
      page doesn't shift the text sideways or change its measure. The top
      padding stands in for the breadcrumbs that space a post's title. */}
  <div class="max-w-[42rem] mx-auto px-4 pt-4 md:pt-14">
    <div>
      <article data-pagefind-body>
        {/* The header sits outside `.prose`, so it keeps Inter's own leading
            and numerals instead of the post body's serif. */}
        <header class:list={['page-header font-sans mb-10', { 'sm:flex sm:items-start sm:gap-x-8': hasAside }]}>
          <div class="min-w-0 flex-1">
            {/* Display step from sm up; on phones the headline step, so a
                sentence-length h1 (About's) runs 3 lines, not 5. */}
            <h1 class="m-0 max-sm:text-headline max-sm:leading-[1.2] text-balance text-gray-900 dark:text-gray-100">
              {Astro.slots.has('heading') ? <slot name="heading" /> : (heading ?? title)}
            </h1>
            {Astro.slots.has('lede') && (
              <p class="mt-3 mb-0 text-lg leading-snug font-medium text-pretty text-gray-700 dark:text-gray-300">
                <slot name="lede" />
              </p>
            )}
            <slot name="header-extra" />
          </div>
          <slot name="header-aside" />
        </header>

        <div class="page-body prose prose-lg prose-primary max-w-none">
          <slot />
        </div>
      </article>
    </div>
  </div>
</BaseLayout>
