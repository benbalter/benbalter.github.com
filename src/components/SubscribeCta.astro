---
/**
 * SubscribeCta
 *
 * Multi-row subscribe/follow card. Renders:
 *  - RSS (always)
 *  - Follow on social (always: Bluesky + LinkedIn)
 *  - Email (inline form when siteConfig.kitFormId is set)
 *
 * The email form posts to the site's own Worker (`POST /api/subscribe`, see
 * worker/subscribe.js), which checks a Cloudflare Turnstile token and then
 * subscribes the address to Kit. The Turnstile script loads only once the form
 * gets focus, so it costs nothing on page views that never touch the form.
 *
 * It's a real `method="post"` form: with JavaScript, the script below submits
 * it with fetch and shows the result inline; without it, the browser posts and
 * the Worker redirects to /subscribe/#subscribe-thanks or #subscribe-error,
 * which `:target` reveals. (Turnstile itself needs JavaScript, so a no-JS post
 * ends at the error message, which points to RSS.)
 */

import Icon from './Icon.astro';
import { siteConfig } from '../config';

/** Turnstile's documented always-pass testing site key, for dev and tests. */
const TURNSTILE_TEST_SITE_KEY = '1x00000000000000000000AA';

const showEmail = Boolean(siteConfig.kitFormId);
const turnstileSiteKey: string =
  import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || siteConfig.turnstileSiteKey || TURNSTILE_TEST_SITE_KEY;
---

<section class="subscribe-card" aria-label="Stay in touch" data-pagefind-ignore>
  <div class="subscribe-row">
    <span class="subscribe-icon" aria-hidden="true"><Icon name="rss" /></span>
    <p class="subscribe-text">
      Like what you read? <a href="/feed.xml" class="subscribe-link">Subscribe via RSS</a> to get notified when new posts are published.
    </p>
  </div>

  {showEmail && (
    <div class="subscribe-row subscribe-email-row">
      <span class="subscribe-icon" aria-hidden="true"><Icon name="envelope" /></span>
      <form class="subscribe-form" method="post" action="/api/subscribe" data-subscribe-form>
        <label class="subscribe-text" for="subscribe-email">
          Prefer email? Subscribe to get new posts in your inbox.
        </label>
        <div class="subscribe-form-fields">
          {/* Honeypot field: hidden from real users; if filled, the submit handler aborts and the Worker ignores it. */}
          <div class="subscribe-honeypot" aria-hidden="true">
            <label for="subscribe-website">Leave this field empty</label>
            <input
              type="text"
              id="subscribe-website"
              name="website"
              tabindex="-1"
              autocomplete="off"
              data-honeypot
            />
          </div>
          <input
            type="email"
            id="subscribe-email"
            name="email"
            placeholder="you@example.com"
            required
            maxlength="254"
            autocomplete="email"
            class="subscribe-input"
          />
          <button type="submit" class="subscribe-button">
            <span class="subscribe-button-text">Subscribe</span>
            <span class="subscribe-spinner" aria-hidden="true"></span>
          </button>
        </div>
        {/* Turnstile renders here (invisible unless it needs the reader to click). */}
        <div class="subscribe-turnstile" data-turnstile data-sitekey={turnstileSiteKey}></div>
        <p class="subscribe-status" aria-live="polite" role="status"></p>
        <p id="subscribe-thanks" class="subscribe-result subscribe-status-success">
          You're on the list. Check your email to confirm.
        </p>
        <p id="subscribe-error" class="subscribe-result subscribe-status-error">
          Something went wrong. Email sign-up needs JavaScript turned on; RSS works without it.
        </p>
        <p class="subscribe-privacy">No spam. Unsubscribe anytime.</p>
      </form>
    </div>
  )}

  <div class="subscribe-row">
    <span class="subscribe-icon" aria-hidden="true"><Icon name="share-nodes" /></span>
    <p class="subscribe-text">
      Or follow along on
      <a href={siteConfig.blueskyUrl} class="subscribe-link" target="_blank" rel="me noopener noreferrer">Bluesky</a>
      or
      <a href={siteConfig.linkedinUrl} class="subscribe-link" target="_blank" rel="me noopener noreferrer">LinkedIn</a>.
    </p>
  </div>
</section>

{showEmail && (
  <script>
    import { onPageLoad } from '../scripts/on-page-load';
    import { track } from '../scripts/track';

    /** The slice of Turnstile's explicit-render API this form uses. */
    interface Turnstile {
      render(container: HTMLElement, options: Record<string, unknown>): string | undefined;
      reset(widgetId?: string): void;
    }

    const TURNSTILE_SRC = 'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit';
    /** How long a submit waits for Turnstile to hand over a token. */
    const TOKEN_TIMEOUT_MS = 15_000;
    const TOKEN_TIMEOUT_ERROR = 'Turnstile timed out';

    let turnstileLoader: Promise<Turnstile> | null = null;

    /** Load Turnstile once per page; a failed load can be retried. */
    function loadTurnstile(): Promise<Turnstile> {
      turnstileLoader ??= new Promise<Turnstile>((resolve, reject) => {
        const script = document.createElement('script');
        script.src = TURNSTILE_SRC;
        script.async = true;
        script.onload = () => {
          const turnstile = (window as unknown as { turnstile?: Turnstile }).turnstile;
          if (turnstile) resolve(turnstile);
          else reject(new Error('Turnstile unavailable'));
        };
        script.onerror = () => {
          turnstileLoader = null;
          script.remove();
          reject(new Error('Turnstile failed to load'));
        };
        document.head.appendChild(script);
      });
      return turnstileLoader;
    }

    /**
     * Render Turnstile into a form on first use and hand out its tokens.
     * Tokens are single-use, so `reset()` after every submit that spent one.
     */
    function turnstileFor(form: HTMLFormElement) {
      const container = form.querySelector<HTMLElement>('[data-turnstile]');
      let widget: Promise<{ turnstile: Turnstile; id: string | undefined }> | null = null;
      let token = '';
      const waiting: Array<(value: string) => void> = [];

      function init() {
        widget ??= loadTurnstile()
          .then((turnstile) => {
            if (!container) throw new Error('No Turnstile container');
            const id = turnstile.render(container, {
              sitekey: container.dataset.sitekey,
              action: 'subscribe',
              appearance: 'interaction-only',
              callback: (value: string) => {
                token = value;
                waiting.splice(0).forEach((resolve) => resolve(value));
              },
              'expired-callback': () => {
                token = '';
              },
            });
            return { turnstile, id };
          })
          .catch((error: unknown) => {
            widget = null;
            throw error;
          });
        return widget;
      }

      return {
        init,
        async token(): Promise<string> {
          await init();
          if (token) return token;
          return new Promise<string>((resolve, reject) => {
            const timer = setTimeout(() => reject(new Error(TOKEN_TIMEOUT_ERROR)), TOKEN_TIMEOUT_MS);
            waiting.push((value) => {
              clearTimeout(timer);
              resolve(value);
            });
          });
        },
        async reset() {
          token = '';
          if (!widget) return;
          try {
            const { turnstile, id } = await widget;
            turnstile.reset(id);
          } catch {
            /* the next init() retries */
          }
        },
      };
    }

    onPageLoad(() => {
      document.querySelectorAll<HTMLFormElement>('form[data-subscribe-form]').forEach((form) => {
        const turnstile = turnstileFor(form);
        form.addEventListener('focusin', () => void turnstile.init().catch(() => {}), { once: true });

        form.addEventListener('submit', async (e) => {
          e.preventDefault();

          // Honeypot: if a bot filled the hidden field, silently abort.
          const honeypot = form.querySelector<HTMLInputElement>('input[data-honeypot]');
          if (honeypot && honeypot.value.trim() !== '') {
            return;
          }

          const emailInput = form.querySelector<HTMLInputElement>('input[type="email"]');
          const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
          const buttonText = button?.querySelector<HTMLSpanElement>('.subscribe-button-text');
          const status = form.querySelector<HTMLParagraphElement>('.subscribe-status');
          const privacy = form.querySelector<HTMLParagraphElement>('.subscribe-privacy');
          if (!emailInput || !button || !buttonText || !status) return;

          const originalText = buttonText.textContent;
          buttonText.textContent = 'Subscribing';
          button.classList.add('loading');
          button.disabled = true;
          emailInput.readOnly = true;

          let message = 'Something went wrong. Please try again.';
          try {
            const body = new URLSearchParams({
              email: emailInput.value,
              website: honeypot?.value ?? '',
              'cf-turnstile-response': await turnstile.token(),
            });
            const response = await fetch(form.action, {
              method: 'POST',
              headers: { Accept: 'application/json' },
              body,
            });
            const result = (await response.json().catch(() => null)) as { ok?: boolean } | null;

            if (response.ok && result?.ok) {
              track('subscribe');
              buttonText.textContent = 'Subscribed ✓';
              button.classList.remove('loading');
              status.textContent = "You're on the list. Check your email to confirm.";
              status.className = 'subscribe-status subscribe-status-success';
              if (privacy) privacy.style.display = 'none';
              emailInput.style.display = 'none';
              form.reset();
              return; // Don't reset: success is permanent
            }
          } catch (error) {
            message =
              error instanceof Error && error.message === TOKEN_TIMEOUT_ERROR
                ? "The spam check didn't finish. Please try again."
                : 'Network error. Please try again.';
          }

          buttonText.textContent = 'Try again';
          status.textContent = message;
          status.className = 'subscribe-status subscribe-status-error';
          button.classList.remove('loading');
          // The token is spent (or never arrived): get a fresh one for the retry.
          void turnstile.reset();

          // Only reset on error so users can retry
          setTimeout(() => {
            buttonText.textContent = originalText;
            button.disabled = false;
            emailInput.readOnly = false;
            status.textContent = '';
            status.className = 'subscribe-status';
          }, 4000);
        });
      });
    });
  </script>
)}

<style>
  @reference "../styles/global.css";

  .subscribe-card {
    @apply flex flex-col gap-2 px-4 py-3 rounded-lg;
    @apply border border-gray-200;
    @apply transition-all duration-200;
  }

  .subscribe-card:hover {
    @apply border-primary/40 shadow-sm;
    background: color-mix(in srgb, var(--color-primary) 3%, transparent);
  }

  .subscribe-row {
    @apply flex items-center gap-3;
  }

  .subscribe-email-row {
    @apply items-start;
  }

  .subscribe-email-row .subscribe-icon {
    @apply mt-0.5;
  }

  .subscribe-icon {
    @apply flex items-center justify-center w-9 h-9 rounded-full;
    @apply bg-primary/10 text-primary;
    @apply transition-colors duration-200;
    flex-shrink: 0;
  }

  .subscribe-card:hover .subscribe-icon {
    @apply bg-primary/20;
  }

  .subscribe-text {
    @apply text-sm text-gray-600 dark:text-gray-400 m-0;
  }

  .subscribe-link {
    @apply text-primary font-semibold no-underline;
    @apply transition-colors duration-200;
  }

  .subscribe-link:hover {
    @apply underline;
  }

  .subscribe-form {
    @apply flex-1 flex flex-col gap-1.5;
  }

  .subscribe-form-fields {
    @apply flex flex-col gap-2;
  }

  /* Honeypot: visually hidden but still in the DOM and form-submittable. */
  .subscribe-honeypot {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
    opacity: 0;
    pointer-events: none;
  }

  @media (min-width: 480px) {
    .subscribe-form-fields {
      @apply flex-row;
    }
  }

  .subscribe-input {
    @apply flex-1 text-sm px-3 py-1.5 rounded-md;
    @apply border border-gray-300 bg-white;
    @apply text-gray-900 placeholder:text-gray-400;
    @apply focus:outline-none focus:ring-2 focus:ring-primary/40 focus:border-primary;
    @apply transition-colors duration-200;
    min-width: 0;
  }

  .subscribe-button {
    @apply text-sm font-semibold px-4 py-1.5 rounded-md;
    @apply bg-primary text-white cursor-pointer;
    @apply hover:bg-primary/90;
    @apply focus:outline-none focus:ring-2 focus:ring-primary/40 focus:ring-offset-2;
    @apply transition-colors duration-200;
    @apply disabled:opacity-60 disabled:cursor-not-allowed;
    @apply inline-flex items-center justify-center gap-2;
    white-space: nowrap;
  }

  .subscribe-button-text {
    @apply inline-block;
  }

  .subscribe-spinner {
    @apply hidden w-3.5 h-3.5 border-2 border-white/30 border-t-white rounded-full;
    animation: subscribe-spin 0.6s linear infinite;
  }

  .subscribe-button.loading .subscribe-spinner {
    @apply inline-block;
  }

  @keyframes subscribe-spin {
    to { transform: rotate(360deg); }
  }

  .subscribe-status {
    @apply text-xs m-0;
  }

  .subscribe-status:empty {
    @apply hidden;
  }

  /* No-JS results: the Worker redirects to #subscribe-thanks or #subscribe-error. */
  .subscribe-result {
    @apply hidden text-xs m-0;
  }

  .subscribe-result:target {
    @apply block;
  }

  .subscribe-privacy {
    @apply text-xs text-gray-600 dark:text-gray-400 m-0;
  }

  .subscribe-status-success {
    @apply text-green-600;
  }

  .subscribe-status-error {
    @apply text-red-600;
  }

  @media (prefers-color-scheme: dark) {
    .subscribe-card {
      @apply border-gray-700;
    }

    .subscribe-card:hover {
      @apply border-primary/30;
      background: color-mix(in srgb, var(--color-primary) 6%, transparent);
    }

    .subscribe-icon {
      @apply bg-primary/20 text-primary-300;
    }

    .subscribe-link {
      @apply text-primary-300;
    }

    .subscribe-card:hover .subscribe-icon {
      @apply bg-primary/30;
    }

    .subscribe-input {
      @apply bg-gray-800 border-gray-600 text-gray-100 placeholder:text-gray-500;
      @apply focus:border-primary-400 focus:ring-primary-400/40;
    }

    .subscribe-button {
      @apply bg-primary-400 text-gray-900;
      @apply hover:bg-primary-300;
      @apply focus:ring-primary-400/40 focus:ring-offset-gray-900;
    }

    .subscribe-status-success {
      @apply text-green-400;
    }

    .subscribe-status-error {
      @apply text-red-400;
    }
  }
</style>
