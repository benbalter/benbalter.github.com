---
/**
 * Share Buttons Component
 *
 * The end-of-post share bar. Sharing is one of the two things a visit is for
 * (see PRODUCT.md), so it leads with one prominent button rather than a row of
 * small icons:
 *
 * - Where the Web Share API exists (most phones), the button opens the native
 *   share sheet, attaching the post's OG card when the platform accepts files.
 * - Elsewhere (most desktops), it relabels itself "Copy link" and copies the
 *   URL with visible and announced confirmation.
 * - Without JavaScript the button is hidden; the network links are plain
 *   anchors and keep working.
 *
 * Every control is at least 44×44px (WCAG 2.5.5, enforced by
 * e2e/mobile-touch-targets.spec.ts).
 */

import Icon from './Icon.astro';
import { getShareUrls } from '../utils/share-urls';

type Network = 'linkedin' | 'bluesky' | 'twitter' | 'email';

interface Props {
  title: string;
  url: string;
  /** Which network links to render, in order. Defaults to all four. */
  networks?: Network[];
  /** Absolute URL of an image (e.g. the OG card) to attach to the native share. */
  shareImage?: string | undefined;
  /** Text for the native share sheet. Defaults to the title. */
  shareText?: string;
}

const {
  title,
  url,
  networks = ['linkedin', 'bluesky', 'twitter', 'email'],
  shareImage,
  shareText,
} = Astro.props;
const urls = getShareUrls(title, url);

const linkDefs: Record<Network, { name: string; icon: string; href: string }> = {
  linkedin: { name: 'LinkedIn', icon: 'linkedin', href: urls.linkedin },
  bluesky: { name: 'Bluesky', icon: 'bluesky', href: urls.bluesky },
  // The `twitter` icon is the X logo; name the network the way readers know it now.
  twitter: { name: 'X', icon: 'twitter', href: urls.twitter },
  email: { name: 'Email', icon: 'envelope', href: urls.email },
};
const shareLinks = networks.map((n) => linkDefs[n]);
---

<section class="post-share" aria-label="Share this post" data-pagefind-ignore>
  <button
    type="button"
    class="post-share-primary"
    data-share-primary
    data-share-url={url}
    data-share-text={shareText ?? title}
    data-share-image={shareImage}
  >
    <span class="post-share-icon" data-share-icon="share"><Icon name="share" size="1.125em" /></span>
    <span class="post-share-icon" data-share-icon="link" hidden><Icon name="link" size="1.125em" /></span>
    <span class="post-share-icon" data-share-icon="check" hidden><Icon name="check" size="1.125em" /></span>
    <span data-share-label>Share this post</span>
  </button>
  <ul class="post-share-networks" role="list">
    {shareLinks.map((link) => (
      <li>
        <a
          href={link.href}
          target={link.name === 'Email' ? undefined : '_blank'}
          rel={link.name === 'Email' ? undefined : 'noopener noreferrer'}
          aria-label={`Share on ${link.name}`}
          title={`Share on ${link.name}`}
          class="post-share-network"
        >
          <Icon name={link.icon} size="1.125em" />
        </a>
      </li>
    ))}
  </ul>
  <span class="sr-only" aria-live="polite" data-share-live></span>
</section>

<script>
  import { copyToClipboard } from '../utils/copy-to-clipboard';

  // Fetch an image (e.g. the OG card) as a File so the OS share sheet can post
  // the image itself; images far outperform bare links in feeds. Returns [] on
  // any failure so the caller can fall back to a text + URL share.
  async function shareImageFiles(imageUrl: string | undefined): Promise<File[]> {
    if (!imageUrl) return [];
    try {
      const res = await fetch(imageUrl);
      if (!res.ok) return [];
      const blob = await res.blob();
      const name = imageUrl.split('/').pop() || 'card.png';
      return [new File([blob], name, { type: blob.type || 'image/png' })];
    } catch {
      return [];
    }
  }

  function showIcon(button: HTMLElement, name: 'share' | 'link' | 'check') {
    button.querySelectorAll<HTMLElement>('[data-share-icon]').forEach((el) => {
      el.hidden = el.dataset.shareIcon !== name;
    });
  }

  function initShareButton(button: HTMLButtonElement) {
    const label = button.querySelector<HTMLElement>('[data-share-label]');
    const live = button.parentElement?.querySelector<HTMLElement>('[data-share-live]');
    const url = button.dataset.shareUrl ?? location.href;
    const canShare = typeof navigator.share === 'function';

    if (!canShare) {
      if (label) label.textContent = 'Copy link';
      showIcon(button, 'link');
    }

    button.addEventListener('click', async () => {
      if (canShare) {
        const text = button.dataset.shareText ?? '';
        const files = await shareImageFiles(button.dataset.shareImage);
        try {
          if (files.length && navigator.canShare?.({ files })) {
            await navigator.share({ text, url, files });
          } else {
            await navigator.share({ text, url });
          }
        } catch {
          /* user dismissed the sheet, or share failed; nothing to do */
        }
        return;
      }

      const ok = await copyToClipboard(url, button);
      if (live) live.textContent = ok ? 'Link copied' : 'Copy failed. Press Ctrl or Cmd + C to copy the address.';
      if (!ok || !label) return;
      label.textContent = 'Link copied';
      showIcon(button, 'check');
      window.setTimeout(() => {
        label.textContent = 'Copy link';
        showIcon(button, 'link');
        if (live) live.textContent = '';
      }, 2000);
    });
  }

  document.querySelectorAll<HTMLButtonElement>('[data-share-primary]').forEach(initShareButton);
</script>

<style>
  @reference "../styles/global.css";

  .post-share {
    @apply mt-12 flex flex-wrap items-center gap-x-4 gap-y-3 border-t border-gray-200 pt-8 font-sans;
  }

  .post-share-primary {
    @apply inline-flex min-h-[44px] cursor-pointer items-center gap-2 rounded-lg px-5 py-2.5 text-base font-semibold;
    @apply bg-primary text-white transition-colors duration-200 hover:bg-primary-600;
    @apply focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary;
    touch-action: manipulation;
  }

  /* Explicit outline: the @apply'd focus-visible utilities computed a white
     (currentColor) ring here, invisible on the light page. */
  .post-share-primary:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  .post-share-primary:active {
    @apply bg-primary-700;
  }

  .post-share-icon {
    @apply inline-flex;
  }

  .post-share-icon[hidden] {
    display: none;
  }

  /* Nothing to do without JS; the network links still work. */
  @media (scripting: none) {
    .post-share-primary {
      display: none;
    }
  }

  .post-share-networks {
    @apply m-0 flex list-none items-center gap-1 p-0;
  }

  .post-share-networks li {
    @apply m-0 p-0;
  }

  .post-share-network {
    @apply inline-flex h-11 w-11 items-center justify-center rounded-lg text-gray-700 no-underline transition-colors duration-200;
    @apply hover:bg-primary/10 hover:text-primary;
    touch-action: manipulation;
  }

  @media (prefers-color-scheme: dark) {
    .post-share {
      @apply border-gray-700;
    }

    /* primary-500 white text is 4.6:1; keep it in dark mode, but darken hover */
    .post-share-primary:hover {
      @apply bg-primary-600;
    }

    .post-share-network {
      @apply text-gray-300 hover:bg-primary/20 hover:text-primary-300;
    }
  }
</style>
