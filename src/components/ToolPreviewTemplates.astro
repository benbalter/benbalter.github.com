---
/**
 * Tool Preview Templates
 *
 * Hover card bodies for links to Ben's free web tools (src/data/tools.ts),
 * one <template> per tool that the post actually links to. Like
 * BookPreviewTemplate, they cost nothing until the first hover;
 * src/scripts/link-previews.ts finds them by `data-link-preview-host`.
 */

import { tools } from '../data/tools';

interface Props {
  /** Rendered post HTML; only tools it links to get a template */
  html: string;
}

const { html } = Astro.props;
const linked = tools.filter((tool) => html.includes(tool.host));
---

{linked.map((tool) => (
  <template data-link-preview-host={tool.host}>
    <div class="link-preview-title">{tool.name}</div>
    <div class="link-preview-description">{tool.pitch}</div>
    <div class="link-preview-meta">Free and open source · Runs in your browser</div>
  </template>
))}
