---
/**
 * KeepReading Component
 *
 * Related posts at the end of a post: the most related post as a prominent
 * card, then the rest as a compact list. The route passes a short list (4), so
 * this stays an invitation, not a wall of exit links competing with the share
 * bar and the book above it.
 *
 * Items fade in as they scroll into view. Graceful degradation: everything is
 * visible without JavaScript.
 */

import type { CollectionEntry } from 'astro:content';
import PostMeta from './PostMeta.astro';
import { stripMarkdown } from '../utils/strip-markdown';
import { getPostMetadata } from '../utils/post-metadata';

interface Props {
  relatedPosts: CollectionEntry<'posts'>[];
}

const { relatedPosts } = Astro.props;

if (relatedPosts.length === 0) return;

const [heroPost, ...morePosts] = relatedPosts;
const hero = getPostMetadata(heroPost);
---

<section class="keep-reading mt-12" aria-labelledby="keep-reading-heading" data-pagefind-ignore>
  <h2 id="keep-reading-heading" class="keep-reading-item mt-0 mb-5 text-xl font-bold" data-keep-reading>Keep reading</h2>

  <div class="keep-reading-item" data-keep-reading>
    <a href={hero.postUrl} class="group block rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 p-6 md:p-8 no-underline transition-all duration-300 hover:border-primary dark:hover:border-primary/50 hover:shadow-md">
      <h3 class="text-2xl md:text-3xl font-bold leading-tight text-gray-900 dark:text-gray-100 group-hover:text-primary dark:group-hover:text-primary-300 transition-colors duration-200 mt-0 mb-3">
        {heroPost.data.title}
      </h3>
      <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-gray-600 dark:text-gray-300 mb-4">
        <PostMeta date={hero.date} isoDate={hero.isoDate} readingTime={hero.readingTime} />
      </div>
      {heroPost.data.description && (
        <p class="text-base text-gray-600 dark:text-gray-300 mb-0 leading-relaxed">
          {stripMarkdown(heroPost.data.description)}
        </p>
      )}
    </a>
  </div>

  {morePosts.length > 0 && (
    <ul class="mt-6 mb-0 list-none p-0 divide-y divide-gray-200 dark:divide-gray-700" role="list">
      {morePosts.map((post) => {
        const meta = getPostMetadata(post);
        return (
          <li class="keep-reading-item group relative m-0 py-4 pl-0" data-keep-reading>
            <h3 class="text-base font-semibold leading-snug mt-0 mb-1">
              <a href={meta.postUrl} class="text-gray-900 dark:text-gray-100 no-underline group-hover:text-primary dark:group-hover:text-primary-300 transition-colors duration-200 before:absolute before:inset-0">
                {post.data.title}
              </a>
            </h3>
            {post.data.description && (
              <p class="text-sm text-gray-600 dark:text-gray-300 mb-0 line-clamp-2">{stripMarkdown(post.data.description)}</p>
            )}
          </li>
        );
      })}
    </ul>
  )}
</section>

<script>
  function initKeepReading() {
    const items = document.querySelectorAll<HTMLElement>('[data-keep-reading]');
    if (items.length === 0) return;

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const STAGGER_MS = 120;

    // `batchIndex` is the item's position among those that came into view in
    // the same observer callback, so the stagger restarts with each batch. A
    // single page-wide counter kept growing, leaving items further down blank
    // for over a second after they scrolled into view.
    function reveal(el: HTMLElement, batchIndex: number) {
      const delay = batchIndex * STAGGER_MS;

      requestAnimationFrame(() => {
        el.style.transition = prefersReducedMotion
          ? 'opacity 0.15s ease'
          : 'opacity 0.5s ease, transform 0.5s ease';
        el.style.transitionDelay = `${delay}ms`;
        el.style.opacity = '1';
        el.style.transform = 'translateY(0)';
      });
    }

    const observer = new IntersectionObserver(
      (entries) => {
        entries
          .filter((entry) => entry.isIntersecting)
          .forEach((entry, batchIndex) => {
            reveal(entry.target as HTMLElement, batchIndex);
            observer.unobserve(entry.target);
          });
      },
      { rootMargin: '0px 0px -40px 0px', threshold: 0.05 }
    );

    items.forEach((item) => observer.observe(item));
  }

  initKeepReading();
</script>

<style>
  @reference "../styles/global.css";

  /* Hide items before JS reveal to avoid CLS from post-paint opacity changes.
     Only when scripts run, so the cards stay visible with JS off. */
  @media (scripting: enabled) {
    [data-keep-reading] {
      opacity: 0;
      transform: translateY(1.25rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-keep-reading] {
      transform: none;
    }
  }

  @media print {
    .keep-reading {
      display: none;
    }
  }
</style>
