---
/**
 * Posts grouped under a heading per year (with an id `YearJumpNav` links to),
 * as two-up post cards. Shared by /posts/ and /github-years/.
 */
import type { CollectionEntry } from 'astro:content';
import PostCard from './PostCard.astro';
import { getPostMetadata } from '../utils/post-metadata';

interface Props {
  /** Years to render, in display order */
  years: number[];
  /** Posts for each year */
  postsByYear: Map<number, CollectionEntry<'posts'>[]>;
}

const { years, postsByYear } = Astro.props;
---

{years.map((year) => {
  const yearPosts = postsByYear.get(year)!;
  return (
    <section class="mb-10">
      <h2 id={`${year}`} class="text-xl font-semibold text-gray-900 dark:text-gray-100 mb-4">
        {year} ({yearPosts.length} {yearPosts.length === 1 ? 'post' : 'posts'})
      </h2>
      <div class="flex flex-wrap -mx-2">
        {yearPosts.map((post) => {
          const { postUrl, date, isoDate, readingTime, isExternal } = getPostMetadata(post);
          return (
            <div class="w-full md:w-1/2 px-2 mb-3">
              <PostCard
                title={post.data.title}
                url={postUrl}
                date={date}
                isoDate={isoDate}
                description={post.data.description}
                readingTime={readingTime}
                external={isExternal}
              />
            </div>
          );
        })}
      </div>
    </section>
  );
})}
