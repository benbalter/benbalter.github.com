# Several third-party Astro integrations (astro-embed, @lucide/astro,
# astro-auto-import, astro-favicons, @playform/compress, astro-seo) declare peer
# dependencies that cap at Astro 6 but work fine with Astro 7's stable
# integration API. legacy-peer-deps lets `npm install`/`npm ci` resolve without
# ERESOLVE failures here and in CI/Cloudflare builds. Remove once these
# integrations ship Astro 7 peer ranges.
legacy-peer-deps=true

# Don't run dependency lifecycle scripts. astro-pdf v1 shipped a hostile
# `preinstall: npx only-allow pnpm` that aborted `npm ci`/`npm install` under
# npm, and skipping scripts matches modern npm's default of not running
# unvetted ones. This is safe here: sharp, esbuild, and workerd all resolve via
# prebuilt platform packages (no build step needed). It does skip puppeteer's
# postinstall Chrome download, which astro-pdf needs for /resume.pdf: CI
# installs it in .github/actions/astro-build-caches, and locally run
# `npx puppeteer browsers install chrome` (or build with SKIP_PDF=1).
ignore-scripts=true
