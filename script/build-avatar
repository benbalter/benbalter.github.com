#!/usr/bin/env node

/**
 * Builds the round headshot shown beside Ben's name in the navigation, and the
 * favicon source from the same crop so the browser tab matches the nav.
 *
 * The source is a large square portrait that isn't committed; only the small
 * derivatives in public/assets/img/ are. The crop is centered on the face with
 * the hair and collar in frame, so it still reads as a face at 40px.
 *
 * sharp drops EXIF and other metadata unless asked to keep it, so no camera or
 * location data reaches the published files.
 *
 * The favicon source is android-chrome-512x512.png. astro-favicons (in
 * astro.config.mjs) generates every icon size from it at build time,
 * overwriting the older hand-made copies in public/. It stays square: iOS fills
 * a transparent home-screen icon's corners with black.
 *
 * Usage: node script/build-avatar <photo.jpg>
 */

import { resolve, join } from 'node:path';
import sharp from 'sharp';

const ROOT = resolve(import.meta.dirname, '..');
const OUT_DIR = join(ROOT, 'public', 'assets', 'img');
const SIZE = 40; // CSS px; matches h-10 w-10 in Navigation.astro

const [photoPath] = process.argv.slice(2);
if (!photoPath) {
  console.error('Usage: node script/build-avatar <photo.jpg>');
  process.exit(1);
}

const { width, height } = await sharp(photoPath).rotate().metadata();

// The center of the head's silhouette (hair, ears, jaw; not the nose, since
// the face is turned slightly) and the crop size, as fractions of the source.
// Tuned for the current portrait; adjust if the photo changes.
const CENTER = { x: 0.507, y: 0.38 };
const SPAN = 0.68;
const side = Math.round(Math.min(width, height) * SPAN);
const crop = {
  left: Math.round(width * CENTER.x - side / 2),
  top: Math.round(height * CENTER.y - side / 2),
  width: side,
  height: side,
};

const master = await sharp(photoPath).rotate().extract(crop).resize(SIZE * 3, SIZE * 3).png().toBuffer();

for (const scale of [1, 2, 3]) {
  const px = SIZE * scale;
  // Named by pixel size, not @2x: Cloudflare's asset server redirects paths
  // containing "@" to their %40-encoded form, an extra round trip per image.
  const base = join(OUT_DIR, `avatar-${px}`);
  await sharp(master).resize(px, px).avif({ quality: 60, effort: 9 }).toFile(`${base}.avif`);
  await sharp(master).resize(px, px).webp({ quality: 82 }).toFile(`${base}.webp`);
}
// The repo-root copy is what astro-favicons reads; the public/ copy is served
// as-is at /android-chrome-512x512.png. Keep them identical.
const favicon = await sharp(photoPath).rotate().extract(crop).resize(512, 512).png({ compressionLevel: 9 }).toBuffer();
for (const dir of [ROOT, join(ROOT, 'public')]) {
  await sharp(favicon).toFile(join(dir, 'android-chrome-512x512.png'));
}

console.log(`Built avatar-${SIZE}/${SIZE * 2}/${SIZE * 3} and the 512px favicon source from a ${side}px crop`);
