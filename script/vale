#!/bin/sh

set -e

if ! [ -x "$(command -v vale)" ]; then
	# Fail loud in CI: a linter that can't run must not silently pass as a
	# green gate. Locally, degrade gracefully so contributors without Vale
	# installed can still run the rest of the suite.
	if [ -n "$CI" ]; then
		echo "ERROR: Vale not found, but \$CI is set — the gate cannot run." >&2
		echo "Refusing to pass silently. Install Vale in the workflow before this step." >&2
		exit 1
	fi
	echo "Vale not found. Skipping prose linting with Vale."
	echo "To install Vale, visit: https://vale.sh/docs/vale-cli/installation/"
	echo "Vale provides additional prose style and grammar checking."
else
	echo "Running Vale prose linter..."
	# Sync packages on first run (the local AIPatterns style is checked in)
	if [ ! -d ".github/styles/proselint" ]; then
		vale sync
	fi
	# Note: /bin/sh may be dash (no brace expansion) — keep globs explicit
	vale ./*.md src/content/posts/*.md src/content/posts/*.mdx src/content/resume-positions/*.md --minAlertLevel=error

	# Agent-instruction files model the house voice for AI agents, so they're
	# held to the no-em-dash rule now, even though AIPatterns.EmDash stays a
	# warning for the post archive. Vale skips code spans, so the rule text's
	# own `—` example passes. Warnings don't change Vale's exit code, so fail
	# on any output instead.
	echo "Checking agent-instruction files for em dashes..."
	emdash=$(vale --filter='.Name=="AIPatterns.EmDash"' --output=line \
		./AGENTS.md src/content/CLAUDE.md \
		.github/agents/*.md .github/instructions/*.md)
	if [ -n "$emdash" ]; then
		echo "$emdash"
		echo "ERROR: em dashes in agent-instruction files (see AGENTS.md writing rules)." >&2
		exit 1
	fi
fi
