#!/bin/sh

set -e

if ! [ -x "$(command -v harper-cli)" ]; then
	echo "Harper not found. Skipping grammar checking with Harper."
	echo "To install Harper, visit: https://github.com/Automattic/harper"
	echo "Harper provides offline, privacy-first grammar checking."
else
	echo "Running Harper grammar checker..."
	# --user-dict-path: reuse the shared personal dictionary (also used by
	#   retext-spell via .remarkrc.js) so proper nouns, acronyms, and names
	#   (FISMA, USDS, GitHubbers, surnames, handles…) don't flood the log as
	#   spelling false positives.
	# --no-color: CI logs aren't a TTY, so Harper's per-character ANSI color
	#   codes render as literal escape sequences (tens of KB of noise).
	# --ignore: disable rules that are style opinions or reliably false-positive
	#   for this blog's voice (verified against a full run — see below). This
	#   keeps a clean baseline: SpellCheck plus the homophone/article/agreement
	#   catchers (AnA, ItsPossessive, ThereToTheir, TheirToThere,
	#   PronounContraction, RepeatedWords) that surface real errors stay on.
	#   Examples of what we mute: SplitWords ("caremad"→"care mad"), DayOneNames
	#   (thinks "day one" is the app), QuantifierNumeralConflict ("some 5,000"),
	#   NeedToNoun ("need to get"), MoreAdjective (labels itself "not an error"),
	#   OxfordComma (flags two-item pairs). (--ignore disables the named rules.)
	HARPER_IGNORE="LongSentences,UseTitleCase,OxfordComma,MoreAdjective,OrthographicConsistency,DisjointPrefixes,SentenceCapitalization,CompoundNouns,SplitWords,RoadMap,DayOneNames,MassNouns,NeedToNoun,QuantifierNumeralConflict,LitotesDirectPositive,MissingPreposition,MissingTo,UnclosedQuotes,ToTwoToo,QuiteQuiet,ThatThan,TheyToThem,PossessiveYour"
	# harper-cli currently always exits with code 1 (even with no lints found),
	#   so we use || true to prevent it from failing the build.
	harper-cli lint --no-color --ignore "$HARPER_IGNORE" --user-dict-path dictionary.txt src/content/posts/*.md || true
fi
