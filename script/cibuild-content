#!/bin/sh

set -e

export CI=1
script/branding

script/title "checking markdown"
# Check-only (no --fix): markdownlint must FAIL CI on violations. script/remark
# is the local auto-fixer; it swallows failures (no set -e, ends on fix-lint),
# so it can't gate. cibuild-content runs under `set -e`, so a non-zero exit here
# fails the job.
npm run lint-md-check

script/title "checking text"
script/lint-text

script/title "checking vale"
script/vale

script/title "checking harper"
script/harper

script/title "checking languagetool"
script/languagetool
