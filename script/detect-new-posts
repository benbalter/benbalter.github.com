#!/usr/bin/env bash
# Lists posts added since the last successful deploy, for the workflows that
# act on new posts (email-broadcast.yml, standard-site-sync.yml). Both share
# this so a fix to the detection reaches both.
#
# Environment:
#   POST_PATH       Manual dispatch: sync just this file (optional)
#   EVENT_NAME      github.event_name
#   HEAD_COMMIT_ID  The deployed commit (github.event.workflow_run.head_commit.id)
#   RUN_ID          The deploy run that triggered this (github.event.workflow_run.id)
#   REPO            owner/name, for the deploy-runs lookup
#   GH_TOKEN        Token with actions: read
#   GITHUB_OUTPUT   Set by Actions; gets has_posts=true|false
#
# Writes the post paths, one per line, to /tmp/new-posts.txt.

set -euo pipefail

: "${GITHUB_OUTPUT:=/dev/stdout}"
OUT=/tmp/new-posts.txt

# Manual dispatch with a specific post path
if [ -n "${POST_PATH:-}" ]; then
  if [ -f "$POST_PATH" ]; then
    echo "$POST_PATH" > "$OUT"
    echo "has_posts=true" >> "$GITHUB_OUTPUT"
    echo "Manual dispatch for: $POST_PATH"
    exit 0
  fi
  echo "❌ File not found: $POST_PATH"
  exit 1
fi

# Manual dispatch without a path: nothing to do
if [ "${EVENT_NAME:-}" = "workflow_dispatch" ]; then
  echo "No post_path provided for manual dispatch"
  echo "has_posts=false" >> "$GITHUB_OUTPUT"
  exit 0
fi

# Diff from the previous successful deploy, not just HEAD~1: the deploy
# cancels in-progress runs, so when merges land close together an earlier
# commit's deploy never succeeds and its posts would otherwise be skipped.
# Only accept an ancestor of this commit, which rules out newer deploys that
# finished first. Fall back to HEAD~1.
#
# Filter on conclusion in jq rather than the API's status=success: that
# filter can return a stale, months-old page instead of the newest runs,
# which picked a July base commit on 2026-09-30 and re-broadcast an old post
# to every subscriber.
#
# Skip only the deploy run that triggered this one (RUN_ID). An earlier
# successful deploy of this same commit (a manual redeploy) is a valid base: it
# gives an empty diff, so its posts aren't detected as new a second time.
#
# The lookup is its own statement so `set -e` fails the step on an API error,
# rather than silently falling back to HEAD~1 and skipping posts.
AFTER="$HEAD_COMMIT_ID"
BEFORE=""
[[ "${RUN_ID:-0}" =~ ^[0-9]+$ ]] || { echo "❌ RUN_ID must be numeric: ${RUN_ID}"; exit 1; }
RUNS=$(gh api "repos/${REPO}/actions/workflows/build-and-deploy.yml/runs?branch=main&status=completed&per_page=100" \
  --jq ".workflow_runs[] | select(.conclusion == \"success\" and .id != ${RUN_ID:-0}) | .head_sha")
for sha in $RUNS; do
  if git merge-base --is-ancestor "$sha" "$AFTER" 2>/dev/null; then
    BEFORE="$sha"
    break
  fi
done
if [ -z "$BEFORE" ]; then
  BEFORE="${AFTER}~1"
  echo "::warning title=New-post detection::No earlier successful deploy found in the last 100 runs; checking only ${BEFORE}..${AFTER}, so posts from older failed deploys may be missed."
fi
echo "Checking for new posts in ${BEFORE}..${AFTER}"

NEW_POSTS=$(git diff --name-only --diff-filter=A "$BEFORE" "$AFTER" -- 'src/content/posts/' 2>/dev/null || echo "")

if [ -z "$NEW_POSTS" ]; then
  echo "No new posts detected"
  echo "has_posts=false" >> "$GITHUB_OUTPUT"
  exit 0
fi

echo "New posts detected:"
echo "$NEW_POSTS"
echo "has_posts=true" >> "$GITHUB_OUTPUT"
echo "$NEW_POSTS" > "$OUT"
