#!/bin/sh

# update-ai-tells — check for a newer tbhb/vale-ai-tells release, bump the pinned
# version in BOTH Vale configs, sync, and report which rules newly fire so a human
# can calibrate .vale-ai-tells.ini before merging.
#
# The version bump is automatable; the calibration is NOT (deciding which new
# rules are Ben's voice vs genuine drift is judgment). So this script goes as far
# as "bump + surface what changed" and leaves a summary for the PR body; it never
# decides disables and never merges. ai-tells is advisory (non-gating), so a stale
# pin never breaks CI — this is a low-urgency nudge.
#
# Usage:
#   script/update-ai-tells [summary-file]   # summary defaults to stdout
# In CI it also writes changed/old/new to $GITHUB_OUTPUT.

set -e

REPO="tbhb/vale-ai-tells"
INI_MAIN=".vale.ini"
INI_ADVISORY=".vale-ai-tells.ini"
SUMMARY="${1:-/dev/stdout}"
POSTS="src/content/posts/2026-*.md src/content/posts/2026-*.mdx"

command -v gh >/dev/null 2>&1 || { echo "gh CLI required"; exit 1; }
command -v vale >/dev/null 2>&1 || { echo "vale required"; exit 1; }

emit() { if [ -n "${GITHUB_OUTPUT:-}" ]; then echo "$1" >>"$GITHUB_OUTPUT"; fi; }

current=$(grep -oE "vale-ai-tells/releases/download/v[0-9.]+" "$INI_ADVISORY" | grep -oE "v[0-9.]+" | head -1)
latest=$(gh release view -R "$REPO" --json tagName -q .tagName)

echo "current: $current   latest: $latest"
if [ "$current" = "$latest" ]; then
	echo "already up to date"
	emit "changed=false"
	exit 0
fi

# Findings under the current (calibrated) config, before the bump.
before=$(mktemp)
# shellcheck disable=SC2086
vale --config="$INI_ADVISORY" --output=line $POSTS 2>/dev/null \
	| grep -oE "ai-tells\.[A-Za-z]+" | sort -u >"$before" || true

# Bump both configs (the two-places gotcha — handled here so neither is missed).
sed -i.bak "s#download/$current/ai-tells#download/$latest/ai-tells#g" "$INI_MAIN" "$INI_ADVISORY"
rm -f "$INI_MAIN.bak" "$INI_ADVISORY.bak"

vale sync >/dev/null

# Findings after the bump — new rules arrive enabled (ai-tells defaults to error).
after=$(mktemp)
# shellcheck disable=SC2086
vale --config="$INI_ADVISORY" --output=line $POSTS 2>/dev/null \
	| grep -oE "ai-tells\.[A-Za-z]+" | sort -u >"$after" || true

newrules=$(comm -13 "$before" "$after" || true)

{
	echo "## ai-tells \`$current\` → \`$latest\`"
	echo ""
	echo "Bumped the pinned version in \`.vale.ini\` and \`.vale-ai-tells.ini\`."
	echo ""
	if [ -n "$newrules" ]; then
		echo "**New rules now firing on 2026 posts.** Calibrate each in \`.vale-ai-tells.ini\` before merging — keep the genuine drift, add \`ai-tells.RuleName = NO\` for anything that's Ben's voice (check against the pre-AI baseline):"
		echo ""
		for r in $newrules; do echo "- \`$r\`"; done
		echo ""
		echo "Sample matches:"
		echo '```'
		for r in $newrules; do
			# shellcheck disable=SC2086
			vale --config="$INI_ADVISORY" --output=line $POSTS 2>/dev/null \
				| grep ":ai-tells\.$r:" | sed -E "s#.*/([^/:]+):([0-9]+):[0-9]+:ai-tells\.$r:#  $r  \1 L\2: #" | head -3
		done
		echo '```'
	else
		echo "No new rules fire on the 2026 posts — safe to merge as-is."
	fi
	echo ""
	echo "_Advisory only; never gates CI. Auto-generated by \`script/update-ai-tells\`._"
} >"$SUMMARY"

rm -f "$before" "$after"
emit "changed=true"
emit "old=$current"
emit "new=$latest"
echo "bumped $current -> $latest"
